over,.courselist_tag_cbanner a:focus{ background: none; border: 1px solid #f90;color: #f90}\r\n.courselist_tag_cbanner .active{ background: #666; color: #fff;}\r\n.courselist_tag .btn_common_1 { border: none; padding: 6px 15px; border-radius: 20px; margin-bottom: 5px; margin-top: 5px;}\r\n.course_banner_1{ color: #fff; margin-top: 20px;}\r\n.course_banner_1 a{ color: #00F5F5; border-bottom: 1px solid #00F5F5;   margin-left: 15px;}\r\n.course_banner_1 a:hover{ color:#f90;border-bottom: 1px solid #f90;}\r\n.article_1{ line-height: 1.7em; font-size: 1.1em; margin-top: 30px; padding-bottom: 30px;}\r\n.article{ background: #fff}\r\n.article h3{ margin-top: 0; padding-top: 35px; padding-bottom: 10px;}\r\n\r\n.class_edit_tit_3 span { width: auto; display: block; float: left; color: #999 }\r\n.class_edit_tit_3 table tr:hover { cursor: pointer }\r\n.class_edit_tit_3 table tr:first-child a { min-width: 50px; display: block; white-space: nowrap; overflow: hidden; color: #00b2b0; font-weight: bold }\r\n.class_edit_tit_3 table tr:first-child a:hover { color: #f90; }\r\n.class_edit_tit_3 table tr:first-child { text-align: center }\r\n.class_edit_tit_3 table tr td { text-align: center!important }\r\n.class_edit_tit_3 table tr td:first-child span { width: 50px; display: block; white-space: nowrap; overflow: hidden; }\r\n.class_edit_tit_3 .glyphicon-ok-sign { text-align: center; color: green; float: none }\r\n.class_edit_tit_3 .glyphicon-question-sign { color: #F9F9F9 }\r\n.outer { padding-right: 0px; overflow: hidden }\r\ndiv.scrollbar { background: rgba(0, 0, 0, 0.5); position: absolute; opacity: 0; cursor: pointer; }\r\ndiv.scrollbar.horizontal { background: #C1C1C1; height: 14px; bottom: 1px; left: 0px; }\r\n\r\n/*单元展开目录*/\r\n\r\n\r\n\r\n.stu_unitlist .panel .panel-heading a[data-toggle=\"collapse\"] {display: block;}\r\n.stu_unitlist .panel .panel-heading a[data-toggle=\"collapse\"]:before {float: right;display: block;content: '–';font-size: 18px;width: 25px; text-align: right;}\r\n.stu_unitlist .panel .panel-heading a[data-toggle=\"collapse\"].collapsed:before{content: '+';}\r\n.stu_unitlist .panel .panel-heading + .panel-collapse .panel-body{border-top: 2px solid #f5f5f5; margin-top: 15px;}\r\n.stu_unitlist .panel-group-joined{border: 1px solid #dddddd;}\r\n.stu_unitlist .panel-group-joined .panel .panel-collapse .panel-body{border-top: 0; padding-top: 0;}\r\n\r\n.stu_unitlist .panel-heading{ margin-bottom: 0; border: none; background: #fff}\r\n.stu_unitlist .panel-heading a{ padding:17px 5px 17px 5px; font-size: 16px; }\r\n.stu_unitlist .panel-heading a:focus{ text-decoration: none}\r\n.stu_unitlist .panel{ padding:0; border: 0; border-bottom: 1px solid #ddd; border-radius: 0; box-shadow: none!important;}\r\n.stu_unitlist .panel-body { margin-top: 0!important; padding: 0!important}\r\n.stu_unitlist_popup .panel-title{ width: 88%; display: inline-block; margin-right: 10px;}\r\n.stu_unitlist_popup .panel-heading button{ margin-top: 12px;}\r\n.stu_unitlist h4 span{ font-weight: bold;}\r\n.stu_testlist_1{ padding-left: 10px; position: relative;}\r\n.stu_testlist_2{ padding-left: 30px;position: relative}\r\n.stu_testlist_3{ padding-left: 45px;position: relative}\r\n.stu_testlist_4{padding-left: 65px;position: relative}\r\n.stu_testlist li{ padding-top: 7px; padding-bottom: 3px; -moz-transition-property: box-shadow, color; -webkit-transition: color .2s linear, background-color .3s linear, border-color .3s linear; -moz-transition: color .2s linear, background-color .3s linear, border-color .3s linear; -o-transition: color .2s linear, background-color .3s linear, border-color .3s linear; -ms-transition: color .2s linear, background-color .3s linear, border-color .3s linear; transition: color .2s linear, background-color .3s linear, border-color .3s linear; }\r\n\r\n.stu_testlist li:hover{ background: #f5f5f5;}\r\n.stu_testlist li:hover span:first-child{ color: #666}\r\n.stu_testlist li:hover a{ background: #5BC0DE; color: #fff; border: 1px solid #5BC0DE}\r\n.course_settings li:hover a { color: #000}\r\n.stu_testlist li .fa-eye,.stu_testlist li .fa-eye-slash{ padding-right: 35px; color: #00b2b0; line-height: 25px; font-size: 1.1em}\r\n.stu_testlist li .fa-eye-slash{ color: #ccc}\r\n.stu_testlist li:hover .fa-eye,.stu_testlist li:hover .fa-eye-slash{ border: none; background: none; color: #00b2b0;}\r\n.stu_testlist li:first-child span:nth-child(4),.stu_testlist li:first-child span:nth-child(5){ white-space: nowrap; font-size: 14px;}\r\n.stu_testlist li:first-child span:nth-child(2){ width: 60px; text-align: right}\r\n\r\n.stu_testlist .fa-circle-o,.stu_testlist .fa-circle,.stu_testlist .fa-certificate,.stu_testlist .fa-check-circle-o,.stu_testlist .fa-ban{ position: relative; bottom: 1px; left: 2px; font-size: 12px!important; color: #999; margin-right: 5px;}\r\n.panel-collapse ul li:before { content: ''; position: absolute;top: 0; left: 16px; bottom: 0; width: 2px; background: #eee; z-index:0;}\r\n.stu_testlist .list-disabled:hover { background:none; }\r\n.stu_testlist li span:first-child{ width:440px; white-space: nowrap; overflow:hidden; text-overflow: ellipsis; display:inline-block}\r\n.stu_unitlist .progress{ width: 110px; height: 10px!important; box-shadow: none!important;border: 1px solid #B7E3FF; border-radius: 30px; background: #fff; margin-top: 3px;}\r\n.progress_fix{ display: block; float: right; font-size: 12px!important; color: #999;  margin-top: 4px;}\r\n.progress_fix span{ color: #0093B9}\r\n.stu_unitlist .progress-bar{ color: #333; padding-left: 12px;box-shadow: none!important; }\r\n.stu_unitlist .progress-bar-info { background: #B7E3FF;}\r\n.stu_testlist .fa-check-circle-o{ color:#13A80D}\r\n.stu_testlist .fa-certificate{ color:#00b2b0}\r\n\r\n.test_ban,.test_ban .fa{ color: #ccc}\r\n.stu_testlist > li span:nth-child(5),.stu_testlist > li span:nth-child(4){padding: 1px 3px 1px 3px; background: #f5f5f5; color: #333; border-radius: 10px; font-size: 14px; margin-right: 10px; min-width: 30px; t