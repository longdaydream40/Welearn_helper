          "content": {
            "size": 6799,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, user-scalable=no\">\r\n    <title>WE Test智能测试系统</title>\r\n    <link rel=\"stylesheet\" href=\"//wetestoss.sflep.com/plugin/bootstrap/3.3.7/css/bootstrap.min.css\">\r\n    <link rel=\"stylesheet\" href=\"//wetestoss.sflep.com/assets/css/fonts/fontawesome/css/font-awesome.min.css\">\r\n    <link href=\"../css/custom.css?d=20220907\" rel=\"stylesheet\">\r\n    <link href=\"../css/yzf.css\" rel=\"stylesheet\">\r\n\r\n    <!--[if lt IE 9]>\r\n      <script src=\"//wetestoss.sflep.com/plugin/html5shiv/3.7.2/html5shiv.min.js\"></script>\r\n      <script src=\"//wetestoss.sflep.com/plugin/respond.js/1.4.2/respond.min.js\"></script>\r\n    <![endif]-->\r\n    <link href=\"//wetestoss.sflep.com/assets/test/css/custom.css\" rel=\"stylesheet\" />\r\n    <link href=\"//wetestoss.sflep.com/assets/css/non-responsive.css\" rel=\"stylesheet\">\r\n    <link href=\"css/classtest.css?v=2022072503\" rel=\"stylesheet\" />\r\n    <link href=\"css/testextend.css?v=20221125\" rel=\"stylesheet\" />\r\n</head>\r\n<body>\r\n    <div id=\"autoSaveErrorInfo\" class=\"center-block\" style=\"text-align: center; position: fixed; bottom: 0; width: 100%; display: none;\">\r\n        <p class=\"bg-warning\" style=\"padding: 5px; margin-bottom: 0;\">自动保存答案失败，请在良好考试网络环境下答题</p>\r\n    </div>\r\n\r\n    <!-- 考试页面 -->\r\n    <div id=\"divTest\" class=\"test-content-wrap\" style=\"display:none;\">\r\n        <div id=\"divTitle\" class=\"fulltab-box\">\r\n            <div id=\"fulltab\" class=\"fulltab\">\r\n                <ul id=\"ulParts\" class=\"container nav nav-tabs\">\r\n                    <li class=\"pull-right\" id=\"spDefaultTimer\">\r\n                        <span id=\"aAnswerSheet\" class=\"test_btn_1 answersheet-control-btn show-sheet\">\r\n                            <a href=\"javascript:void(0);\" class=\"btn btn-default\">答题卡&nbsp;<i class=\"fa fa-angle-down\" aria-hidden=\"true\"></i><i class=\"fa fa-angle-up\" aria-hidden=\"true\"></i></a>\r\n                        </span>\r\n                        <span id=\"spTimer\" class=\"fa fa-clock-o timer\"></span>\r\n                        <span id=\"spTempSubmit\" class=\"test_btn_1\">\r\n                            <a href=\"javascript:doNextTime();\" class=\"btn btn-default\">下次再做</a>\r\n                        </span>\r\n                        <span id=\"spSubmit\" class=\"test_btn_1\">\r\n                            <a href=\"javascript:preSubmit(true);\" class=\"btn btn-default btn_common_3\">交卷</a>\r\n                        </span>\r\n                    </li>\r\n                </ul>\r\n            </div>\r\n        </div>\r\n        <div id=\"divContent\" class=\"container\">\r\n            <div class=\"row tab-content-wrap\" style=\"margin-top:69px;\">\r\n                <div class=\"tab-content test_preview col-xs-12 col-sm-9\" id=\"divTestPaper\">\r\n                    <div class=\"text-center btn_common_4\">\r\n                        <a role=\"button\" class=\"btn btn-primary_1 btnPrePart\" id=\"btnPrePart\" href=\"javascript:SelPrevPart();\" style=\"display:none;\">上一部分</a>\r\n                        <a role=\"button\" class=\"btn btn-primary_1 btnNextPart\" id=\"btnNextPart\" href=\"javascript:SelNextPart();\" style=\"display:none;\">保存，进入下一部分</a>\r\n                        <a role=\"button\" class=\"btn btn-primary_1 btnLastSave\" id=\"btnLastSave\" href=\"javascript:savePaperAnswer(false);\" style=\"display:none;\">保 存</a>\r\n                        <a role=\"button\" class=\"btn btn-primary_1 btnBottomSubmit\" id=\"btnBottomSubmit\" href=\"javascript:preSubmit(true);\" style=\"display:none;\">交 卷</a>\r\n                    </div>\r\n                </div>\r\n                <div class=\"col-sm-3 hidden-xs answer_sheet\" id=\"sidebar\" style=\"height:953px;top:69px;left:919px;\">\r\n                    <div id=\"ulAnswerSheet\"></div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div id=\"divHidden\" style=\"display:none; height:0;\">\r\n            <div id=\"soundplayer\"></div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- 考试结束页面 -->\r\n    <div id=\"divFinishInfo\" class=\"full-screen-wrap submit-success-wrap\" style=\"display: none;\">\r\n        <div class=\"content-box\">\r\n            <div class=\"title\">交卷成功！</div><ul class=\"test-info\">\r\n                <li>\r\n                    <div class=\"label-text\">姓名：</div><div class=\"info\" id=\"test-finish-name\"></div>\r\n                </li>\r\n                <li><div class=\"label-text\">学号：</div><div class=\"info\" id=\"test-finish-studentno\"></div></li>\r\n                <li><div class=\"label-text\">用时：</div><div class=\"info\" id=\"test-finish-minutes\"></div></li>\r\n            </ul><div class=\"footer-btn-group\"><button id=\"btnFinishTest\" onclick=\"Return();\" type=\"button\" class=\"btn btn-primary_1\">返回</button></div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- 通用提示框 -->\r\n    <div class=\"modal fade bs-example-modal-sm\" id=\"modalNotify\" tabindex=\"100\" role=\"dialog\" data-backdrop=\"static\">\r\n        <div class=\"modal-dialog\" role=\"document\" style=\"margin-top: 50px;\">\r\n            <div class=\"modal-content\" style=\"padding-bottom:0;\">\r\n                <div id=\"notifyContent\" class=\"modal-body\" style=\"text-align: center;padding:30px 0 20px 0;\"></div>\r\n                <div class=\"modal-footer\" style=\"padding:8px;\">\r\n                    <button type=\"button\" id=\"btnNotifyOk\" class=\"btn btn-primary\">确定</button>\r\n                    <button type=\"button\" id=\"btnNotifyCancel\" class=\"btn btn-default\">取消</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <script src=\"//wetestoss.sflep.com/assets/js/jquery-1.11.1.min.js\"></script>\r\n    <script src=\"//wetestoss.sflep.com/plugin/bootstrap/3.3.7/js/bootstrap.min.js\"></script>\r\n    <script type=\"text/javascript\" src=\"//wetestoss.sflep.com/assets/test/js/swfobject.js\"></script>\r\n    <script type=\"text/javascript\" src=\"//wetestoss.sflep.com/assets/test/js/jwplayer.js\"></script>\r\n    <script type=\"text/javascript\" src=\"//wetestoss.sflep.com/assets/test/js/jwpsrv.js\"></script>\r\n    <script type=\"text/javascript\" src=\"//wetestoss.sflep.com/assets/test/js/jwplayer.html5.js\"></script>\r\n    <script type=\"text/javascript\" src=\"//wetestoss.sflep.com/assets/test/js/jwpsrv_frq.js\"></script>\r\n    <script type=\"text/javascript\" src=\"//wetestoss.sflep.com/assets/test/js/respond.src.js\"></script>\r\n    <script type=\"text/javascript\" src=\"//wetestoss.sflep.com/plugin/jquery/jquery.cookie.js\"></script>\r\n    <script type=\"text/javascript\" src=\"//wetestoss.sflep.com/plugin/moment/2.24.0/moment.js\"></script>\r\n    <script type=\"text/javascript\" src=\"script/WelearnTest.js?v=20251010\"></script>\r\n</body>\r\n</html>"
