答 start */\r\n.tcta .wenda{padding-top: 20px; margin-top: 20px; margin-bottom: 0; border-top: 1px solid #f1f0f0; border-bottom: none;}\r\n.tcta .wenda h5{color: #666;}\r\n.tcta .wenda_1{margin-top: 5px; margin-bottom: 0;}\r\n.tcta .form-control{resize: vertical;}\r\n.tcta .answer-box{width: 100%; height: auto; font-size: 14px;}\r\n.tcta .answer-box li{background: #f5f5f5; margin-top: 10px; padding: 15px; overflow: hidden;}\r\n.tcta .answer-box .user-icon{width: 55px; float: left;}\r\n.tcta .answer-box .user-icon img{width: 35px; border: 3px solid #e9e9e9; border-radius: 180px; overflow: hidden;}\r\n.tcta .answer-box .answer{line-height: 24px; margin-top: -7px;}\r\n.tcta .answer-box .info{margin-top: 10px; color: #999; overflow: hidden; zoom: 1;}\r\n.tcta .answer-box .info span{margin-right: 15px;}\r\n/* 参与问答 end */\r\n\r\n/* 班级公告 start */\r\n.list_announce .new-announce-num,.stu-class-announce .new-announce-num{margin-left: 5px; font-weight: normal; font-size: 14px;}\r\n.list_announce .new-announce-num i{font-style: normal; font-weight: bold;}\r\n.list_announce .new-announce,.stu-class-announce .new-announce{font-weight: bold;}\r\n/* 班级公告 end */\r\n\r\n/* 本校考试 start */\r\n.tea-exam-manage .examstatus-tag-started{color: #76b236;}\r\n/* 本校考试 end */\r\n\r\n/* 发布考试 start */\r\n.tea_exam_publish .test-paper-list{padding-top: 5px;}\r\n.tea_exam_publish .test-paper-list a{margin-right: 10px; color: #00b2b0;}\r\n.tea_exam_publish .test-paper-list a:hover{color: #00cec8;}\r\n.tea_exam_publish .timeinterval-prompt{float: left; line-height: 34px;}\r\n.tea_exam_publish .prompt{display: inline-block; margin-top: 7px; vertical-align: middle;}\r\n.tea_exam_publish .custom-time-box input{display: inline-block; width: 100px;}\r\n.tea_exam_publish .custom-time-box .prompt{margin-top: 0;}\r\n.modal-delete-exam .modal-dialog{width: 450px;}\r\n.modal-delete-exam .modal-body{text-align: center;}\r\n/* 发布考试 end */\r\n\r\n/* 教师端-考试统计 start */\r\n@keyframes rotating {\r\n  0% {\r\n    trans