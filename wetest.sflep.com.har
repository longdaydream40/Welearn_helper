            "mimeType": "application/javascript",
            "text": "\r\nvar testEnv = { testKey: \"\", backUrl: \"\", testId: 0, resPath: \"//wetestoss.sflep.com/resource/\", allowPaste: false };\r\n\r\n//初始化\r\n(function initEnv() {\r\n    var lingYangRedirectHost = location.host == \"sfleptest.sflep.com\" ? \"ssittest.sflep.com/ep\" : \"welearn.sflep.com\";\r\n    $(\"#aCustomerService\").attr(\"href\", \"https://\" + lingYangRedirectHost + \"/LingYangRedirect.aspx\");\r\n\r\n    String.prototype.replaceAll = function (s1, s2) {\r\n        return this.replace(new RegExp(s1, \"gm\"), s2);\r\n    }\r\n\r\n    //设置ajax参数\r\n    $.ajaxSetup({\r\n        type: \"post\",\r\n        dataType: \"json\",\r\n        contentType: \"application/json;charset=UTF-8\",\r\n        timeout: 60000\r\n    });\r\n\r\n    //获取测试环境参数\r\n    var sp = new URLSearchParams(location.search);\r\n    testEnv.testKey = encodeURIComponent(sp.get('testKey'));\r\n    testEnv.backUrl = sp.get('backUrl');\r\n}());\r\n\r\nfunction fobiddenAction() {\r\n    if (testEnv.allowPaste)\r\n        return;\r\n\r\n    //禁止复制、剪切、粘贴、选择、右键菜单等\r\n    document.oncopy = function () { return false; };\r\n    document.oncut = function () { return false; };\r\n    document.onpaste = function () { return false; };\r\n    document.oncontextmenu = new Function(\"event.returnValue=false;\");\r\n    document.onselectstart = new Function(\"event.returnValue=false;\");\r\n}\r\n\r\n$(document).ready(function () {\r\n    if (!testEnv.testKey || testEnv.testKey.length == 0) {\r\n        alert(\"考试参数错误，无法参加考试\");\r\n        Return();\r\n    }\r\n\r\n    fobiddenAction();\r\n    InitTest();\r\n});\r\n\r\nvar allowRequest = true;\r\n\r\n//获取提交连接\r\nfunction getActionUrl(action) {\r\n    return \"../api/WelearnTest.aspx?action=\" + action;\r\n}\r\n\r\nvar studentTestId = 0;\r\n\r\n//加载考试试卷\r\nfunction InitTest() {\r\n    showNotify(\"正在加载试卷内容请稍候...\");\r\n    $.ajax({\r\n        url: \"../api/WelearnTest.aspx?action=initTest&testKey=\" + testEnv.testKey,\r\n        success: function (res) {\r\n            if (res.status > 0) {\r\n                changeNotify(res.msg, Return);\r\n                return;\r\n            }\r\n\r\n            hideNotify();\r\n\r\n            //已完成的直接显示结果信息\r\n            if (res.data.isFinish) {\r\n                showSubmitResult(res.data);\r\n                return;\r\n            }\r\n\r\n            //未完成的展示考试界面\r\n            remainSeconds = res.data.remainSeconds;\r\n\r\n            if (res.data.paperAnswer != null)\r\n                paperAnswer = res.data.paperAnswer;\r\n\r\n            $('#divTestPaper').prepend(res.data.paperContent);\r\n            $('#ulAnswerSheet').html(res.data.answerSheet);\r\n            GenerateHeadPartHtml();\r\n\r\n            $(\"input[type='text']\").css(\"user-select\", \"text\");\r\n            $(\"textarea\").css(\"user-select\", \"text\");\r\n\r\n            initEvent();\r\n            initPageStyle();\r\n\r\n            startTimer();\r\n\r\n            $('#aTemporarySubmit').show();\r\n            $('#aSubmit').show();\r\n\r\n            $(\"#divLoading\").hide();\r\n            $(\"#divTest\").show();\r\n            questionItemsFloat();\r\n\r\n            $(\"#aPart\" + (res.data.partNum > 0 ? res.data.partNum : 1)).click();\r\n            testEnv.testId = res.data.testId;\r\n            //testId = testEnv.testId;\r\n        },\r\n        error: function (a, b, c) {\r\n            changeNotify(\"加载试卷失败，点击确定重新加载试卷，点击取消退出考试。\", InitTest, Return);\r\n        }\r\n    });\r\n}\r\n\r\nvar passageTimer = null;\r\nvar leaveLogTime = null;\r\nvar currentTarget = null;\r\nvar isLeave = false;\r\nfunction initEvent() {\r\n    $('.choiceList').each(function () {\r\n        $(this).change(autoSaveAnswer);\r\n    });\r\n\r\n    $('select').each(function () {\r\n        $(this).change(autoSaveAnswer);\r\n    });\r\n\r\n    $('input:text').each(function () {\r\n        var obj = $(this);\r\n        obj.keydown(resizeInputSize);\r\n\r\n        //防止回车引起的问题\r\n        obj.keypress(function (e) {\r\n            var code = e.which || window.event.keyCode;\r\n            if (code == 13) return false;\r\n        });\r\n\r\n        var qType = obj.attr(\"data-qtype\");\r\n        //短文改错题需要先保存原始数据供恢复使用\r\n        if (qType == \"errorCorrectionPassage\")\r\n            obj.focus(InitErrorCorrectPassageDefaultValue);\r\n\r\n        //选择填空检查输入内容是否合法\r\n        if (qType == \"bankedCloze\")\r\n            obj.blur(CheckBankedClozeInput);\r\n        else\r\n            obj.blur(autoSaveAnswer);\r\n    });\r\n\r\n    $('textarea:not([id=\"txtLogInfo\"])').each(function () {\r\n        var obj = $(this);\r\n        var areaValue = obj.val();\r\n        if (areaValue.length > 0)\r\n            obj.val(areaValue.replaceAll(\"<br/>\", \"\\n\").replaceAll(\"<br />\", \"\\n\").replaceAll(\"\\n\\n\", \"\\n\"));\r\n\r\n        obj.blur(function (e) {\r\n            if (passageTimer != null) {\r\n                clearInterval(passageTimer);\r\n                currentTarget = null;\r\n            }\r\n            autoSaveAnswer(e);\r\n        });\r\n\r\n        //每30秒自动保存\r\n        obj.focus(function (e) {\r\n            if (passageTimer != null)\r\n                clearInterval(passageTimer);\r\n            currentTarget = e;\r\n            passageTimer = setInterval(function () { autoSaveAnswer(currentTarget); }, 30000);\r\n        });\r\n\r\n        //写作题检测字数限制\r\n        if (obj.attr(\"data-qtype\") == \"writing\") {\r\n            StatWritingWordsCount(obj.attr(\"id\"), true);\r\n            obj.keyup(StatWritingWordsCountEvent);\r\n        }\r\n    });\r\n\r\n    window.onblur = function (e) {\r\n        leaveLogTime = new moment();\r\n        console.log(\"离开考试：\" + leaveLogTime.format(\"YYYY-MM-DD HH:mm:ss.SSS\"));\r\n        //saveLog(1, 0);\r\n        isLeave = true;\r\n    }\r\n    window.onfocus = function (e) {\r\n        if (!leaveLogTime)\r\n            return;\r\n\r\n        var duration = parseInt((new moment() - leaveLogTime) / 1000) + 1;\r\n        leaveLogTime = null;\r\n\r\n        console.log(\"返回考试：\" + new moment().format(\"YYYY-MM-DD HH:mm:ss.SSS\") + \", 离开时长:\" + duration + \"秒\");\r\n        if (duration > 10)\r\n            saveLog(2, duration);\r\n\r\n        if (remainSeconds <= 0) {\r\n            stopTimer();\r\n            preSubmit(false);\r\n            return;\r\n        }\r\n\r\n        isLeave = false;\r\n        if (duration > 10) {\r\n            showNotify(\"系统检查到你离开了考试页面，为避免影响考试成绩，请尽快回到考试中！\", hideNotify);\r\n        }\r\n    }\r\n\r\n    $('body').on('contextmenu', '.itemDiv .radio', function () {\r\n        if (!$(this).hasClass('color-gray-1')) {\r\n            $(this).addClass('color-gray-1');\r\n        } else {\r\n            $(this).removeClass('color-gray-1');\r\n        }\r\n        return false;\r\n    });\r\n}\r\n\r\nfunction saveLog(type, duration) {\r\n    $.ajax({\r\n        url: getActionUrl(\"saveLog\"),\r\n        data: JSON.stringify({ testId: testEnv.testId, type: type, duration: duration, nocache: Math.random() })\r\n    });\r\n}\r\n\r\nfunction removeEvent() {\r\n    leaveLogTime = null;\r\n    window.onblur = null;\r\n    window.onfocus = null;\r\n}\r\n\r\n//计时、保持相关\r\nvar timer = null;\r\nvar remainSeconds = 0;\r\nvar keepAliveTime = null;\r\n\r\nfunction startTimer() {\r\n    timer = setInterval(showTimer, 1000);\r\n    keepAliveTime = new Date();\r\n}\r\n\r\nfunction stopTimer() {\r\n    if (timer)\r\n        clearInterval(timer);\r\n}\r\n\r\nfunction showTimer() {\r\n    remainSeconds--;\r\n    if (remainSeconds < 0)\r\n        remainSeconds = 0;\r\n\r\n    var h = parseInt(remainSeconds / 3600);\r\n    var m = parseInt((remainSeconds - h * 3600) / 60);\r\n    var s = remainSeconds % 60;\r\n    var timeDisplay = (h + '').padStart(2, '0') + ':' + (m + '').padStart(2, '0') + ':' + (s + '').padStart(2, '0');\r\n    $('#spTimer').text(timeDisplay);\r\n\r\n    if (remainSeconds <= 0) {\r\n        stopTimer();\r\n        preSubmit(false);\r\n        return;\r\n    }\r\n\r\n    if (new Date().getTime() - keepAliveTime.getTime() > 300000) {\r\n        keepAlive();\r\n    }\r\n}\r\n\r\nfunction keepAlive() {\r\n    if (!allowRequest)\r\n        return;\r\n\r\n    $.ajax({\r\n        url: getActionUrl(\"keepAlive\"),\r\n        data: JSON.stringify({ testId: testEnv.testId, nocache: Math.random() }),\r\n        success: function (res) {\r\n            if (res.status == 0) {\r\n                if (res.data.submited) {\r\n                    removeEvent();\r\n                    $(\"#divTest\").remove();\r\n                    showSubmitResult(res.data);\r\n                }\r\n                else\r\n                    remainSeconds = res.data.remainSeconds;\r\n            }\r\n        }\r\n    });\r\n    keepAliveTime = new Date();\r\n}\r\n\r\nfunction Return() {\r\n    location.href = testEnv.backUrl ? testEnv.backUrl : \"https://welearn.sflep.com\";\r\n}\r\n\r\n//保存答案\r\nvar paperAnswer = {};\r\n\r\n//题目答案\r\nfunction autoSaveAnswer(e) {\r\n    if (isLeave)\r\n        return;\r\n\r\n    //console.log(\"开始自动保存答案：\" + new moment().format(\"YYYY-MM-DD HH:mm:ss.SSS\"));\r\n    //console.log(e);\r\n    try {\r\n        var qnum = e.target.dataset.qnum;\r\n        if (isNaN(qnum) || parseInt(qnum) <= 0)\r\n            return;\r\n\r\n        var nodeName = e.target.nodeName;\r\n        if (nodeName == \"INPUT\") {\r\n            nodeName = e.target.attributes.type.nodeValue;\r\n        }\r\n\r\n        var targetId = e.target.id;\r\n        var value = \"\";\r\n        if (nodeName == \"radio\")\r\n            value = e.target.dataset.id;\r\n        else {\r\n            value = $(\"#\" + targetId).val();\r\n            if (e.target.dataset.select)\r\n                value = e.target.dataset.select + \",\" + value;\r\n        }\r\n        paperAnswer[qnum] = { key: qnum, value: encodeURIComponent(value), type: \"question\" };\r\n\r\n        if (value.length == 0) {\r\n            //答题卡取消完成标记\r\n            $('#aQuestion' + qnum).removeClass('answer_sheet_2');\r\n\r\n            //短文改错如果学生清空自己答案，需要加载原始数据\r\n            if (e.target.dataset.qtype == \"errorCorrectionPassage\") {\r\n                restoreErrorCorrectionPassage(e);\r\n            }\r\n        }\r\n        else {\r\n            //答题卡标记完成\r\n            $('#aQuestion' + qnum).addClass('answer_sheet_2');\r\n        }\r\n\r\n        autoSaveData({\r\n            testId: testEnv.testId,\r\n            partNum: curPartNum,\r\n            answerDetail: {\r\n                key: qnum,\r\n                value: encodeURIComponent(value),\r\n                type: \"question\",\r\n                clientTime: new Date().toLocaleString()\r\n            }\r\n        }, \"autoSaveAnswer\");\r\n    } catch (ex) {\r\n        execException(ex, \"autoSaveAnswer\");\r\n    }\r\n}\r\n\r\n//音频次数\r\nfunction autoSaveSound(soundKey, remainTimes) {\r\n    paperAnswer[soundKey] = { key: soundKey, value: remainTimes, type: \"sound\" };\r\n    var saveData = {\r\n        testId: testEnv.testId,\r\n        partNum: curPartNum,\r\n        answerDetail: {\r\n            key: soundKey,\r\n            value: remainTimes,\r\n            type: \"sound\",\r\n            clientTime: new Date().toLocaleString()\r\n        }\r\n    };\r\n    autoSaveData(saveData, \"autoSaveSound\");\r\n}\r\n\r\nfunction autoSaveData(data, type) {\r\n    try {\r\n        $.ajax({\r\n            url: \"../api/WelearnTest.aspx?action=saveQuestion&nocache=\" + Math.random(),\r\n            data: JSON.stringify(data),\r\n            success: function (res) {\r\n                if (res.status == 0) {\r\n                    if (res.data.submited) {\r\n                        removeEvent();\r\n                        $(\"#divTest\").remove();\r\n                        showSubmitResult(res.data);\r\n                    }\r\n                    else\r\n                        remainSeconds = res.data.remainSeconds;\r\n                }\r\n            },\r\n            error: function (a, b, c) {\r\n                execAjaxError(a, b, c, type);\r\n            }\r\n        });\r\n    } catch (ex) {\r\n        execException(ex, type);\r\n    }\r\n}\r\n\r\nfunction preSubmit(isManual) {\r\n    if (!isManual) {\r\n        showNotify(\"考试时间已到，系统将自动收卷\");\r\n        setTimeout(function () { savePaperAnswer(true); }, 2000);\r\n    }\r\n    else {\r\n        var totalQCount = $(\".answer_sheet_1 a\").length;\r\n        var finishedQCount = $(\".answer_sheet_2\").length;\r\n        var msg = totalQCount - finishedQCount > 0 ? \"您还有题目未答，确定要现在交卷吗？\" : \"确认交卷？\";\r\n        showNotify(msg, function () { savePaperAnswer(true); }, hideNotify);\r\n    }\r\n}\r\n\r\n//保存答案\r\nvar savePaperAnswerFailedCount = 0;\r\nfunction savePaperAnswer(submit) {\r\n    if (!allowRequest)\r\n        return;\r\n\r\n    allowRequest = false;\r\n    //todo 根据测试情况决定是否再对学生答案完整性进行一次检查\r\n    if (submit)\r\n        changeNotify(\"正在提交考试答案，请稍候。\");\r\n    else\r\n        showNotify(\"正在保存考试数据，请稍候。\");\r\n\r\n    try {\r\n        $.ajax({\r\n            url: \"../api/WelearnTest.aspx?action=savePaper&nocache=\" + Math.random(),\r\n            data: JSON.stringify({ testId: testEnv.testId, partNum: curPartNum, Answers: paperAnswer, Submit: submit, ClientTime: new Date().toLocaleString() }),\r\n            success: function (res) {\r\n                if (res.status > 0) {\r\n                    if (res.status == 100)\r\n                        showNotify(\"非学生账号考试不保存答题数据\", Return);\r\n                    else\r\n                        changeNotify(res.msg, hideNotify);\r\n                    return;\r\n                }\r\n\r\n                hideNotify();\r\n                if (res.data.submited) {\r\n                    removeEvent();\r\n                    $(\"#divTest\").remove();\r\n                    showSubmitResult(res.data);\r\n                }\r\n            },\r\n            error: function (a, b, c) {\r\n                execAjaxError(a, b, c, \"savePaperAnswer\");\r\n            },\r\n            complete: function () {\r\n                allowRequest = true;\r\n            }\r\n        });\r\n    } catch (ex) {\r\n        execException(ex, \"savePaperAnswer\");\r\n    }\r\n}\r\n\r\nfunction execException(ex, key) {\r\n    console.log(key + \"ex:\" + new moment().format(\"YYYY-MM-DD HH:mm:ss.SSS\"));\r\n    console.log(ex);\r\n    uploadError(key + \", ex=\" + JSON.stringify(ex));\r\n}\r\n\r\nfunction execAjaxError(a, b, c, key) {\r\n    console.log(key + \"error：\" + new moment().format(\"YYYY-MM-DD HH:mm:ss.SSS\"));\r\n    console.log(a);\r\n    console.log(b);\r\n    console.log(c);\r\n\r\n    if (a.status < 2) {\r\n        if (key == \"autoSaveAnswer\")\r\n            showNotify(\"网络异常，请检查您的网络连接，否则无法保存题目答案\", hideNotify);\r\n        else\r\n            showNotify(\"网络异常，请检查您的网络连接，否则无法保存题目答案\", hideNotify);\r\n        return;\r\n    }\r\n\r\n    if (key == \"uploadError\")\r\n        return;\r\n\r\n    if (key != \"savePaperAnswer\") {\r\n        uploadError(key + \", ajax error:\" + generateErrorMsg(a, b, c));\r\n        return;\r\n    }\r\n\r\n    //提交试卷时出现错误\r\n    if (savePaperAnswerFailedCount < 2) {\r\n        savePaperAnswerFailedCount++;\r\n        changeNotify(\"提交试卷出现错误，请重新提交\", hideNotify);\r\n        return;\r\n    }\r\n\r\n    var errorMsg = generateErrorMsg(a, b, c);\r\n    uploadError(key + \", savePaperAnswer count2,ajax error:\" + errorMsg);\r\n    showNotify(\"保存答案出现错误，请将本提示拍照或截图发邮件至：service@sflep.com （\" + errorMsg + \"）。\", hideNotify);\r\n}\r\n\r\nfunction generateErrorMsg(a, b, c) {\r\n    var errorMsg = \"\";\r\n    try {\r\n        if (a)\r\n            errorMsg = \"status=\" + a.status + \",readystate=\" + a.readyState + \",stext=\" + a.statusText;\r\n        if (b)\r\n            errorMsg += \"；\" + JSON.stringify(b);\r\n        if (c)\r\n            errorMsg += \"；\" + JSON.stringify(c);\r\n\r\n        errorMsg += \";testId=\" + testEnv.testId + \";time=\" + new moment().format(\"YYYY-MM-DD HH:mm:ss.SSS\");\r\n    } catch (e) {\r\n        errorMsg = \"error2=\" + JSON.stringify(e);\r\n    }\r\n    return errorMsg;\r\n}\r\n\r\nfunction uploadError(content) {\r\n    $.ajax({\r\n        url: \"../api/error.aspx?action=fronterror\",\r\n        contentType: \"application/x-www-form-urlencoded\",\r\n        data: { testId: testEnv.testId, content: content },\r\n        type: \"Post\",\r\n    });\r\n}\r\n\r\nfunction doNextTime() {\r\n    showNotify(\"确定下次再做吗？\", Return, hideNotify);\r\n}\r\n\r\n//显示交卷结果\r\nfunction showSubmitResult(result) {\r\n    stopTimer();\r\n    $(\"#test-finish-name\").text(result.studentName || \"\");\r\n    $(\"#test-finish-studentno\").text(result.studentNo || \"\");\r\n    $(\"#test-finish-minutes\").text(result.minutes + \"分钟\");\r\n    $(\"#divFinishInfo\").show();\r\n}\r\n\r\n//提示相关\r\nfunction showHideDom(dom, event) {\r\n    if (event) {\r\n        dom.click(event);\r\n        dom.show();\r\n    }\r\n    else {\r\n        dom.hide();\r\n        dom.unbind(\"click\");\r\n    }\r\n}\r\n\r\nfunction showNotify(content, okEvent, cancelEvent) {\r\n    //hideModal();\r\n\r\n    $(\"#notifyContent\").text(content);\r\n    showHideDom($(\"#btnNotifyOk\"), okEvent);\r\n    showHideDom($(\"#btnNotifyCancel\"), cancelEvent);\r\n    $(\"#modalNotify\").modal(\"show\");\r\n    $(\"#modalNotify\").focus();\r\n}\r\n\r\nfunction changeNotify(content, okEvent, cancelEvent) {\r\n    $(\"#notifyContent\").text(content);\r\n    showHideDom($(\"#btnNotifyOk\"), okEvent);\r\n    showHideDom($(\"#btnNotifyCancel\"), cancelEvent);\r\n    $(\"#modalNotify\").focus();\r\n}\r\n\r\nfunction hideNotify() {\r\n    $(\"#modalNotify\").modal(\"hide\");\r\n    $(\"#btnNotifyOk\").unbind(\"click\");\r\n    $(\"#btnNotifyCancel\").unbind(\"click\");\r\n}\r\n\r\nfunction hideModal() {\r\n    $(\".modal\").each(function () {\r\n        $(this).modal(\"hide\");\r\n    });\r\n}\r\n\r\nfunction showAutoSaveErrorNotify() {\r\n    $(\"#autoSaveErrorInfo\").show();\r\n    setTimeout(function () { $(\"#autoSaveErrorInfo\").hide(1000) }, 2000);\r\n}\r\n\r\n//切换part、question\r\nvar curPartNum = 0;\r\nfunction SelPart(num) {\r\n    if (curPartNum == num)\r\n        return;\r\n\r\n    $(\".partDiv\").hide();\r\n    if (soundPlayer)\r\n        soundPlayer.stop();\r\n\r\n    curPartNum = num;\r\n    //切换底部按钮显示      \r\n    if (curPartNum >= $('#ulParts li a[id^=\"aPart\"]').length) {\r\n        $('#btnNextPart').hide();\r\n        $('#btnBottomSubmit').show();\r\n        $('#btnLastSave').show();\r\n    }\r\n    else {\r\n        $('#btnNextPart').show();\r\n        $('#btnBottomSubmit').hide();\r\n        $('#btnLastSave').hide();\r\n    }\r\n\r\n    if (curPartNum == 1)\r\n        $(\"#btnPrePart\").hide()\r\n    else\r\n        $(\"#btnPrePart\").show()\r\n\r\n    //显示html并滚动到最上方\r\n    $(\"#part\" + num).show();\r\n    scrollTo(0, 0);\r\n}\r\nfunction SelPrevPart() {\r\n    $('#aPart' + (curPartNum - 1)).click();\r\n}\r\nfunction SelNextPart() {\r\n    if (curPartNum > 0)\r\n        savePaperAnswer(false);\r\n    $('#aPart' + (curPartNum + 1)).click();\r\n\r\n}\r\nfunction SelQuestion(partNum, questionNum) {\r\n    $(\"#aPart\" + partNum).click();\r\n\r\n    if ($('#question_' + questionNum).length > 0) {\r\n        var pos = $('#question_' + questionNum).offset().top - 200;\r\n        $(\"html,body\").animate({ scrollTop: pos }, 1000);\r\n    }\r\n}\r\n\r\n//句子改错题，自动补充选中项信息\r\nfunction selectErrorCorrectItem(obj, id, position) {\r\n    var value = $(obj).text();\r\n\r\n    var liEcs = $('#liECS_' + id);\r\n    liEcs.text(value + ' - ');\r\n    liEcs.parent().show();\r\n\r\n    $(\"#txtECS_\" + id).attr(\"data-select\", position);\r\n}\r\n\r\n//短文改错题，需临时保存原始数据，当用户清空填写内容时恢复默认值\r\nvar errorCorrectOrigin = {};\r\nfunction InitErrorCorrectPassageDefaultValue(e) {\r\n    var qnum = e.target.dataset.qnum;\r\n    if (!errorCorrectOrigin[qnum])\r\n        errorCorrectOrigin[qnum] = $(\"#\" + e.target.id).val();\r\n}\r\nfunction restoreErrorCorrectionPassage(e) {\r\n    var qnum = e.target.dataset.qnum;\r\n    if (errorCorrectOrigin[qnum])\r\n        $(\"#\" + e.target.id).val(errorCorrectOrigin[qnum]);\r\n}\r\n\r\n//写作题检查并提示字数超限信息\r\nfunction StatWritingWordsCountEvent(e) {\r\n    StatWritingWordsCount(e.target.id);\r\n}\r\nfunction StatWritingWordsCount(id, disableAlert) {\r\n    var content = $('#' + id).val();\r\n    var spWordCountId = \"#spWordCount_\" + id.split('_')[1];\r\n    content = content.replace(/\\n/g, ' ');\r\n    content = content.replace(/^\\s\\s*/, '').replace(/\\s\\s*$/, '');\r\n    if (content.length == 0)\r\n        $(spWordCountId).text(0);\r\n    else {\r\n        var count = content.split(/\\s+/g).length;\r\n        $(spWordCountId).text(count);\r\n        if (count > 10000 && !disableAlert)\r\n            showNotify(\"作文字数不能超过5000，超过部分会被忽略，请修改\", hideNotify);\r\n    }\r\n}\r\n\r\n//选词填空，判断填的是否是编号，并统一转为大写字母\r\nfunction CheckBankedClozeInput(e) {\r\n    var value = $(\"#\" + e.target.id).val();\r\n    if (value.length > 0) {\r\n        if (value.length != 1) {\r\n            $(\"#\" + e.target.id).val(\"\");\r\n            showNotify(\"Please input the letter identify the choice.\", hideNotify);\r\n            //setTimeout(alert('Please input the letter identify the choice.'), 500);\r\n            return;\r\n        }\r\n\r\n        value = value.toUpperCase();\r\n        const code = value.charCodeAt(0);\r\n        if (code < 65 || code > 90) {\r\n            $(\"#\" + e.target.id).val(\"\");\r\n            showNotify(\"Please input the letter identify the choice.\", hideNotify);\r\n            //setTimeout(alert('Please input the letter identify the choice.'), 500);\r\n            return;\r\n        }\r\n\r\n        $(\"#\" + e.target.id).val(value);\r\n    }\r\n\r\n    autoSaveAnswer(e);\r\n}\r\n\r\n//动态调整输入框长度\r\nfunction resizeInputSize(e) {\r\n    resize_txt(document.getElementById(e.target.id));\r\n}\r\n\r\nvar txtsize = 8;\r\nvar max_length = 26;\r\nfunction resize_txt(ctr) {\r\n    if (!ctr)\r\n        return;\r\n\r\n    var inputLength = ctr.value.length || 0;\r\n    var currentSize = ctr.size || 0;\r\n    if (inputLength + 3 < currentSize || max_length < currentSize)\r\n        return;\r\n\r\n    if (inputLength > max_length) {\r\n        ctr.size = max_length + 3;\r\n        ctr.style.width = max_length * 10 + 10;\r\n    }\r\n    else {\r\n        ctr.size = inputLength + 3;\r\n        ctr.style.width = inputLength * 10 + 10;\r\n    }\r\n}\r\n\r\n//音视频播放相关\r\nvar lastSoundId = \"\";\r\nvar currentSoundId = \"\";\r\nvar soundPlayer;\r\nfunction PlaySound(src, id) {\r\n    //clearTimeout(bufferingTimer);\r\n\r\n    var remainCount = 3;\r\n    if (paperAnswer && paperAnswer[id]) {\r\n        try {\r\n            remainCount = parseInt(paperAnswer[id].value);\r\n        } catch (e) {\r\n\r\n        }\r\n    }\r\n\r\n    if (remainCount <= 0)\r\n        return;\r\n\r\n    if (soundPlayer) {\r\n        soundPlayer.stop();\r\n        try {\r\n            jwplayer(\"soundplayer\").remove();\r\n        } catch (e) {\r\n\r\n        }\r\n    }\r\n    SetCurrentSoundInfo();\r\n\r\n    currentSoundId = id;\r\n    const soundfile = testEnv.resPath + \"sound/\" + src;\r\n\r\n    soundPlayer = jwplayer(\"soundplayer\").setup({\r\n        flashplayer: \"script/jwplayer.flash.swf?c=\" + Math.random(),\r\n        file: soundfile,\r\n        height: 0,\r\n        width: 0,\r\n        primary: \"html5\"\r\n    });\r\n    soundPlayer.play();\r\n\r\n    soundPlayer.onBufferFull(function () {\r\n        SetCurrentSoundInfo();\r\n    });\r\n\r\n    $('#btnPlay_' + currentSoundId).html('<span class=\" fa fa-play-circle play_symble\">正在加载</span>');\r\n    $('#btnPlay_' + currentSoundId).addClass('loading');\r\n\r\n    remainCount--;\r\n    autoSaveSound(currentSoundId, remainCount);\r\n\r\n    //if (remainCount <= 0) \r\n    //    sp.attr(\"href\", \"javascript:void(0);\");\r\n}\r\n\r\nvar bufferingTimeLimit = 20000;\r\nvar bufferingTimer;\r\nfunction PlayerExpireCheck(id, time) {\r\n    if (!soundPlayer)\r\n        return;\r\n\r\n    time += 1000;\r\n    var state = soundPlayer.getState(); //alert(state);\r\n    if (state != undefined && state != 'buffering')\r\n        return;\r\n\r\n    if (time >= bufferingTimeLimit) {\r\n        soundPlayer.stop();\r\n\r\n        var sp = $('#btnPlay_' + id);\r\n        if (sp.length > 0) {\r\n            var remainCount = !paperAnswer || !paperAnswer[id] ? 3 : paperAnswer[id].value;\r\n            sp.html('<span class=\" fa fa-play-circle play_symble\">' + remainCount + '次播放机会</span>');\r\n            sp.removeClass('loading');\r\n        }\r\n    }\r\n    else\r\n        bufferingTimer = setTimeout(\"PlayerExpireCheck('\" + id + \"', \" + time + \")\", 1000);\r\n}\r\n\r\nfunction SetCurrentSoundInfo() {\r\n    if (currentSoundId == \"\")\r\n        return;\r\n\r\n    var remainCount = 0;\r\n    if (paperAnswer && paperAnswer[currentSoundId]) {\r\n        try {\r\n            remainCount = parseInt(paperAnswer[currentSoundId].value);\r\n        } catch (e) {\r\n        }\r\n    }\r\n\r\n    var sp = $('#btnPlay_' + currentSoundId);\r\n    if (sp.length > 0) {\r\n        sp.html('<span class=\" fa fa-play-circle play_symble\">' + remainCount + '次播放机会</span>');\r\n        sp.removeClass('loading');\r\n\r\n        //if (remainCount == 0)\r\n        //    sp.attr(\"href\", \"javascript:void(0);\");\r\n    }\r\n}\r\n\r\nfunction CreateVideoPlayer(playerID, src) {\r\n    var videofile = testEnv.resPath + \"video/\" + src;\r\n    jwplayer(playerID).setup({\r\n        flashplayer: \"script/jwplayer.flash.swf?c=\" + Math.random(),\r\n        file: videofile,\r\n        height: 180,\r\n        width: 280,\r\n        primary: \"html5\"\r\n    });\r\n}\r\n\r\nconst romanNumList = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII', 'XIII', 'XIV', 'XV'];\r\nfunction GenerateHeadPartHtml() {\r\n    var partHtml = \"\";\r\n    var partCount = $(\".partDiv\").length;\r\n    for (var i = 0; i < partCount; i++) {\r\n        const partNum = i + 1;\r\n        const romanNum = romanNumList.length > i ? romanNumList[i] : \"\";\r\n        try {\r\n            partHtml += '<li><a id=\"aPart' + partNum + '\" href=\"#\" data-toggle=\"tab\" onclick=\"SelPart(' + partNum + ');\"><i class=\"visible-xs\">' + romanNum + '</i><span class=\"hidden-xs\">Part ' + romanNum + '</span></a></li>';\r\n        } catch (e) {\r\n\r\n        }\r\n    }\r\n    $(\"#ulParts\").prepend(partHtml);\r\n}\r\n\r\n//dpp\r\n//计算答题卡位置\r\nfunction questionItemsFloat() {\r\n    var clientHeight = document.documentElement.clientHeight;\r\n    var clientWidth = document.documentElement.clientWidth;\r\n    var sidebarId = $('#sidebar');\r\n\r\n    var fulltabHeight = $('.fulltab-box').outerHeight();\r\n    var testWrapWidth = $('.tab-content-wrap').outerWidth();\r\n    var testContentWidth = $('.tab-content').outerWidth();\r\n\r\n    $('.tab-content-wrap').css({ 'margin-top': fulltabHeight + 15 + 'px' });\r\n    sidebarId.css({\r\n        'height': (clientHeight - fulltabHeight - 35) + 'px',\r\n        'top': (fulltabHeight + 15) + 'px'\r\n    });\r\n\r\n    if (clientWidth > 960) {\r\n        sidebarId.css({\r\n            'left': (clientWidth - testWrapWidth) / 2 + testContentWidth + 12 + 'px'\r\n        });\r\n    } else if (clientWidth <= 960 && clientWidth > 768) {\r\n        sidebarId.css({\r\n            'left': (960 - testWrapWidth) / 2 + testContentWidth + 12 + 'px'\r\n        });\r\n    } else {\r\n        sidebarId.css({\r\n            'left': testContentWidth + 12 + 'px'\r\n        });\r\n    }\r\n};\r\n\r\n//dpp\r\n//答题卡显示隐藏\r\nfunction initPageStyle() {\r\n    $('body').on('click', '#aAnswerSheet', function () {\r\n        if ($(this).hasClass('show-sheet')) {\r\n            $(this).removeClass('show-sheet').addClass('hide-sheet');\r\n            $('.answer_sheet').hide();\r\n            $('.test_preview').removeClass('col-sm-9').addClass('col-sm-12');\r\n        } else {\r\n            $(this).removeClass('hide-sheet').addClass('show-sheet');\r\n            $('.test_preview').removeClass('col-sm-12').addClass('col-sm-9');\r\n            $('.answer_sheet').show();\r\n        }\r\n    });\r\n};\r\n\r\n//窗口重置\r\n$(window).resize(function () {\r\n    questionItemsFloat();\r\n});\r\n\r\n"
          },
