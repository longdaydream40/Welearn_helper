            "mimeType": "text/css",
            "text": "body{ font: 12px/1.5 arial,Helvetica Neue,tahoma,\"Hiragino Sans GB\",Microsoft YaHei,\\5b8b\\4f53; font-size: 14px;  background: #F0F1F1;overflow-y: scroll;}\r\nimg { border: 0; vertical-align: top; }\r\nul ,ol ,dd { margin: 0; padding: 0 }\r\nli ,ol ,dd{ list-style: none; list-style-type: none }\r\na { font-size: 14px; blr:expression(this.onFocus=this.blur());\r\ncolor: #333333; text-decoration: none; }\r\na:hover,a:focus { color: #FF9900; text-decoration: none;outline: none; }\r\na, input { font-size: 14px; outline: none; -moz-transition-property: box-shadow, color; -webkit-transition: color .2s linear, background-color .3s linear, border-color .3s linear; -moz-transition: color .2s linear, background-color .3s linear, border-color .3s linear; -o-transition: color .2s linear, background-color .3s linear, border-color .3s linear; -ms-transition: color .2s linear, background-color .3s linear, border-color .3s linear; transition: color .2s linear, background-color .3s linear, border-color .3s linear }\r\ntd img, td input, td textarea, td checkbox { vertical-align: middle; outline: none; }\r\ninput, textarea { font-family: \"微软雅黑\", Tahoma, sans-serif; outline: none; }\r\ntextarea { margin-left: 2px; margin-left: 0px\\9; }\r\n.form-control{-webkit-box-shadow:none;  box-shadow:none; }\r\n.form-control:focus{box-shadow: none;}\r\n.btn:active,.btn:focus{outline: none!important; box-shadow: none!important}\r\nh3 a{ font-size: 24px;}\r\nh6{ font-size: 16px; line-height: 21px}\r\n/*.navbar_cus{ background: #fff; border-radius: 0; margin-bottom: 10px;}*/\r\n.navbar-inverse {\r\n  background: #2b2b2b\\9; background-image: -ms-linear-gradient(top, rgba(38, 38, 38, 0.9) 0, rgba(43, 43, 43, 0.9) 100%); background-image: -moz-linear-gradient(top, rgba(38, 38, 38, 0.9) 0, rgba(43, 43, 43, 0.9) 100%); background-image: -o-linear-gradient(top, rgba(38, 38, 38, 0.9) 0, rgba(43, 43, 43, 0.9) 100%); background-image: -webkit-gradient(linear, left top, left bottom, color-stop(0, #262626), color-stop(1, #2b2b2b)); background-image: -webkit-linear-gradient(top, rgba(38, 38, 38, 0.9) 0, rgba(43, 43, 43, 0.9) 100%); background-image: linear-gradient(to bottom, rgba(38, 38, 38, 0.9) 0, rgba(43, 43, 43, 0.9) 100%);  z-index: 100; \r\n}\r\n/*.navbar-brand {height: 51px;padding: 11px 15px 11px 0px; width: 225px; }*/\r\n.navbar-nav{ margin-left: 60px;}\r\n.navbar-right > li:hover .dropdown-menu {display: block;}\r\n.navbar-nav > li:hover .dropdown-menu {display: block;}\r\n.tea_add_task .dropdown:hover .dropdown-menu {display: block; margin-top: -1px;}\r\n.tea_add_task .dropdown-menu li { padding-top: 5px; padding-bottom: 5px;}\r\n.tea_add_task .dropdown-menu li a:hover{ color: #00CDCB}\r\n.tea_add_task .dropdown-menu{ min-width: 95px;}\r\n.dropdown a:hover{ background: #fff!important; color: #f90}\r\n.alert{ margin-bottom: 10px;}\r\n.search {  padding-right:0; padding-left: 0}\r\n.search_1 { border: 0; border-bottom: 1px solid #d5d5d5;background: #fff; outline: none; color: #333; border-radius: 0; width: 435px!important; background-color: transparent}\r\n.search_1:focus{border-bottom: 1px solid #d5d5d5;}\r\n.search_2 { background: #fff; color: #666; border: 0; cursor: pointer; float: right;  border-radius: 0; height: 34px; border-bottom: 1px solid #d5d5d5;}\r\n.search_2:hover,.search_2:focus {background: #fff; color: #00b2b0;border-bottom: 1px solid #d5d5d5;  }\r\n.search_3{ background-color: #555; color: #fff; border: 0; border-radius: 0}\r\n.search_4{ width: 370px!important;}\r\n/*针对safari的hack*/\r\n_::-webkit-full-page-media, _:future, :root .search_2 {height: 34px; margin-top: 0}\r\n_::-webkit-full-page-media, _:future, :root .search_3 { background-color: transparent!important;color: #fff; border: 0; border-radius: 0}\r\n/*针对safari的hack-end*/\r\n.list-group-item { border: none; border-radius: 0}\r\n.main_carousel{ margin-bottom: 10px; margin-top: -10px;}\r\n.main_carousel .carousel{ height: 363px; overflow: hidden; }\r\n.main_carousel_bookslist .carousel{ height: 245px; overflow-y: hidden; }\r\n/* wy-mod-banner */\r\n.x_info { width: 328px; height: 230px; position: absolute; right: 0;  background: url(../images/txt1.png) no-repeat; top: -295px; z-index: 5 }\r\n.x_info .link-download, .x_info .link-download_2, .x_info_2 .link-download { font-size: 20px;  padding: 10px 33px; overflow: hidden; position: absolute; bottom: 28px; right: 157px; cursor: pointer; text-decoration: none;  background: none; color: #fff;}\r\n.x_info .link-download_2 { right: 40px;background: #f60; border-radius: 6px;  }\r\n.x_info_2 .link-download { right: 70px;  }\r\n.x_info .link-download_2:hover{ background: #FF3E00}\r\n.clumn_tit{ margin-top: 15px; padding-bottom: 10px; margin-bottom: 15px}\r\n.clumn_tit:before{ content: \"\"; width: 4px; display: block; float: left; background: #00CCCA; height: 21px; margin-left: -15px;}\r\n.clumn_tit_2{ margin-top: 40px;padding-bottom: 10px; margin-bottom: 10px; font-size: 24px; text-align: center;}\r\n.main_carousel_bookslist .carousel-control{ background: #000; width: 40px; height: 40px; margin: 0 15px; margin-top: 5%; border-radius: 50px; opacity: 0.3;}\r\n.main_carousel_bookslist .carousel-control:hover{opacity: 1}\r\n.main_carousel_bookslist .carousel-control .glyphicon-chevron-left{ top: 50%; left: 40%; font-size: 20px;}\r\n.main_carousel_bookslist .carousel-control .glyphicon-chevron-right{ top: 50%; right: 40%; font-size: 20px;}\r\n.main_carousel_bookslist .item .col-xs-3:nth-child(5){ display: none}\r\n/* wy-mod-banner -end*/\r\n\r\n.index_xcb{ background: #fff; border: 1px solid #ddd;border-radius: 0; margin-bottom: 10px; padding-top: 20px; padding-bottom: 20px; margin-top: -10px; border: none; margin-top: 10px}\r\n.index_xcb .row{ font-size: 16px; color: #888;}\r\n.index_xcb .row > div{ padding-left: 0; }\r\n.index_xcb .row > div:before{ content: \"\"; width: 1px; height: 140px; margin-top: 20px; background: #ddd; display: block; float: left}\r\n.index_xcb .row > div:first-child:before{ background: #fff}\r\n.index_xcb .fa{ font-size: 32px; border: 1px solid #00B2B0; border-radius: 55px; width: 60px; height: 60px; padding-top: 14px; margin-bottom: 15px; color: #00b2b0;}\r\n.index_xcb .row .col-xs-3{ transition: all .3s}\r\n.index_xcb .row .col-xs-3:hover{ margin-top: -5px!important;}\r\n.more_1{ margin-top: 5px; color: #999}\r\n.rate{ width: 100%; display: block}\r\n.user{color: #999; margin-bottom: 5px; font-size: 12px;}\r\n.prise{ color: #5fb41b}\r\n.prise_1{ color: #f00; font-size: 16px; margin-top: -3px;}\r\n.stat_rate{ font-size: 9px;}\r\n.stat_rate .fa-star,.stat_rate .fa-star-half-empty{ color: #f90; margin-left: 3px;}\r\n.stat_rate .fa-star-o{ color: #ccc;margin-left: 3px;}\r\n.nu_pup { position: absolute; top: 13px; right: 3px; background: #f00; height: 10px;  width: 10px; border-radius: 50%; border: 2px solid #fff}\r\n.nav_message,.nav_mine { display: block;  height: 31px; margin-top: 9px; width: 32px;}\r\n.nav_message .glyphicon,.nav_mine .glyphicon,.nav_mine .fa { color: #999; top: -7px; left: -5px;}\r\n.nav_register{ height: 50px;  line-height: 50px; padding: 7px 10px 0px 6px!important;color: #4D555D}\r\n.nav_register a { color: #4D555D}\r\n.nav_mine .fa{  position: absolute;    color: #fff; top:7px; left: 11px;\r\n    font-size: 18px;\r\n}\r\n.nav_mine img{ margin-top: -9px; margin-left: -5px;}\r\n.dropdown-menu_quick{ width: 280px; background: #fff; color: #333; padding: 0px 15px 3px 15px;}\r\n.dropdown-menu_quick a:hover{ color: #333}\r\n.dropdown-menu_quick .media-left a img{ width: 70px;}\r\n.dropdown-menu_quick .media{ border-bottom: 1px solid #ddd;}\r\n.dropdown-menu_quick_1{ padding:0; min-width: 330px; background: #fff; }\r\n.dropdown-menu_quick_1 .list-group { margin-bottom: 0; width: 665px;}\r\n.dropdown-menu_quick_1 .list-group a{ height: 50px; line-height: 30px; font-size: 17px; color: #333; white-space: nowrap; width: 330px; display: inline-block}\r\n.dropdown-menu_quick_1 .list-group a:hover{ background: #f5f5f5!important; color: #333}\r\n.dropdown-menu_quick_1 .list-group a .glyphicon{ margin-right: 10px; color: #ccc}\r\n.dropdown-menu_quick_1 a img{ width: 33px; margin-top: 3px; margin-right: 5px; border-radius: 3px;}\r\n.dropdown_mine{min-width: 100px;}\r\n.dropdown_mine li a{ padding-top: 6px; padding-bottom: 6px;}\r\n.dropdown_mine li a:hover{ background: #F0F1F1!important}\r\n.sidebar{ padding-left: 0}\r\n.sidebar_2{background: #fff}\r\n.user_icon { padding: 20px 0; text-align: center; margin-bottom: 10px; background: #fff;  }\r\n.user_icon_1 { margin-top: 10px; font-size: 18px; }\r\n.user_icon_2{position: relative;}\r\n.user_icon_2 a{ font-size: 10px; padding: 2px 6px; border-radius: 15px; background: #eee; color: #666; position: absolute; top: -150px; right: 5px; border: 3px solid #fff}\r\n.user_icon img { border: 3px solid #E3E3E3; width: 98px; height: 98px;}\r\n.sidebar_2 { margin-bottom: 10px;}\r\n.sidebar_2 li a{ border-radius: 0; color: #333; font-size: 16px;}\r\n.sidebar_2 li a span{ color: #D6D6D6; margin-right: 10px; font-size: 98%}\r\n.sidebar_2 li a:hover{ background-color: #00b2b0; color: #fff;}\r\n.sidebar_2 li a:hover span{ color: #fff}\r\n.shortcut ul a:hover { background: #00b2b0 }\r\n.nav-pills > li.active > a {color: #fff;background-color: #00b2b0;}\r\n.nav-pills > li.active > a span{ color: #fff;}\r\n.nav-pills > li.active > a:hover{color: #fff;background-color: #00b2b0;}\r\n.footer .nav a{ font-size: 13px; padding-left: 0; padding-right: 20px}\r\n.footer .nav > li > a:hover{ background-color:#282828!important; }\r\n.footer .navbar-right li{ color: #666; font-size: 12px; line-height: 50px;}\r\n.main_right { padding: 0;}\r\n.announce_index .alert{ border-radius: 0; padding: 10px 35px 10px 15px; margin-bottom: 10px;}\r\n.alert .glyphicon { font-size: 90%; margin-right: 10px; color: #2C90C1;}\r\n.alert-warning a span{ color: #f90; padding: 0 5px;}\r\n.shortcut { text-align: center;  padding: 28px 0; background: #fff; margin-bottom: 10px;}\r\n.shortcut ul { width: 70px; display:inline-block;margin-right: 35px;}\r\n.shortcut ul:last-child{ margin-right: 0}\r\n.shortcut ul a { width: 70px; display: block; height: 70px; line-height: 70px; text-align: center; overflow: hidden; position: relative; border-radius: 180px; margin-bottom: 10px; }\r\n.shortcut a .fa{ font-size: 210%; color: #fefefe; line-height: 70px;}\r\n.shortcut ul:nth-child(1) a{ background: #F06E6E }\r\n.shortcut ul:nth-child(2) a{ background: #F3A343 }\r\n.shortcut ul:nth-child(3) a{ background: #8DD332 }\r\n.shortcut ul:nth-child(4) a{ background: #00becb }\r\n.shortcut ul:nth-child(5) a{ background: #B67DDA }\r\n.shortcut ul:nth-child(6) a{ background: #00C8F1}\r\n.shortcut ul a:hover { background: #00b2b0;}\r\n/*标签页*/\r\n.nav.nav-tabs {\r\n  border-bottom: 0;\r\n}\r\n\r\n\r\n.nav-tabs > li.active > a,\r\n.nav-tabs > li.active > a:hover,\r\n.nav-tabs > li.active > a:focus {\r\n  color: #555;\r\n  cursor: default;\r\n  background-color: #fff;\r\n  border: 1px solid transparent;\r\n  border-bottom-color: transparent;\r\n}\r\n.nav.nav-tabs.right-aligned {\r\n  text-align: right;\r\n}\r\n.nav.nav-tabs.right-aligned > li {\r\n  float: none;\r\n  display: inline-block;\r\n}\r\n.nav.nav-tabs.right-aligned > li > a {\r\n  margin-right: 0;\r\n  margin-left: 5px;\r\n}\r\n.nav.nav-tabs.nav-tabs-justified {\r\n  display: table;\r\n  width: 100%;\r\n  table-layout: fixed;\r\n  border-collapse: separate;\r\n}\r\n.nav.nav-tabs.nav-tabs-justified:before,\r\n.nav.nav-tabs.nav-tabs-justified:after {\r\n  display: none;\r\n}\r\n.nav.nav-tabs.nav-tabs-justified > li {\r\n  display: table-cell;\r\n  vertical-align: top;\r\n  width: 1%;\r\n  text-align: center;\r\n}\r\n.nav.nav-tabs.nav-tabs-justified > li:last-child > a {\r\n  margin-right: 0;\r\n}\r\n.tab-content_1{ background: #fff; padding: 15px; margin-top: 10px;}\r\n.tab_custom_1{ height: 68px; line-height: 68px;}\r\n.tab_custom_1 > li > a{ font-size: 17px; padding: 24px 5px 15px 5px; color: #666; margin-right: 25px; position: relative; }\r\n.tab_custom_1 li a:hover{ background: #fff; color: #F20D0D;border:1px solid transparent; }\r\n.tab_custom_1 li a span{ position: absolute; width: 10px; height: 10px; display: block; background: #f00; border: 2px solid #fff;border-radius: 50%; top: 22px; right: 0px}\r\n.tab_custom_1 .active a{ color: #F20D0D!important;border-bottom: 4px solid #F20D0D!important}\r\n.tab_custom_2{ height: 68px; background: #fff; box-shadow: 0 2px 6px 0 rgba(28,31,33,.1);}\r\n.tab_custom_3 a{ font-size: 16px;}\r\n.tab_custom_3 > li > a:hover { border-color: #f0f1f1; border-bottom: 1px solid #f0f1f1; background: #f0f1f1}\r\n/*标签页-end*/\r\n.main_carousel_bookslist_1{ margin-bottom: 10px;}\r\n.books_tag{  margin-bottom: 20px;border-top: 5px solid #f4f4f4; padding-top: 15px; }\r\n.books_tag li a{ padding: 6px 15px;  margin-right: 10px; margin-bottom: 5px; font-size: 16px; border-radius: 30px;}\r\n.books_tag li a:hover,.books_tag li a:focus{ background: #00b2b0!important; color: #fff!important}\r\n.tab-content0{ padding: 0!important; margin-bottom: 0!important}\r\n.main_carousel_bookslist_1 .books_tag .active a{ background: #00b2b0; color: #fff} \r\n\r\n.btn_more{ border: none;background-color:transparent; padding-right: 0}\r\n.btn_more:hover,.btn_more:focus{background-color:transparent; border: none;color: #00b2b0}\r\n.btn_common_1{ color: #fff;-moz-transition-property: box-shadow, color; -webkit-transition: color .2s linear, background-color .3s linear, border-color .3s linear; -moz-transition: color .2s linear, background-color .3s linear, border-color .3s linear; -o-transition: color .2s linear, background-color .3s linear, border-color .3s linear; -ms-transition: color .2s linear, background-color .3s linear, border-color .3s linear; transition: color .2s linear, background-color .3s linear, border-color .3s linear; padding: 8px 25px; background: #00B4B2; border: 1px solid #00B4B2}\r\n.btn_common_1:hover{ background-color: #00C6C4; color: #fff;border: 1px solid #00C6C4}\r\n.btn_common_3{ border: none; background-color: #f60; color: #fff;-moz-transition-property: box-shadow, color; -webkit-transition: color .2s linear, background-color .3s linear, border-color .3s linear; -moz-transition: color .2s linear, background-color .3s linear, border-color .3s linear; -o-transition: color .2s linear, background-color .3s linear, border-color .3s linear; -ms-transition: color .2s linear, background-color .3s linear, border-color .3s linear; transition: color .2s linear, background-color .3s linear, border-color .3s linear; box-shadow: none;}\r\n.btn_common_3:hover{ background-color: #f90; color: #fff;}\r\n\r\n\r\n.tab_myclass{ width: 100%; display: block; float: left; padding: 15px!important;}\r\n.tea_my_class { width: 690px; display: block; float: left; margin-top: 25px; border-bottom: 1px solid #e0e0e0; }\r\n.tea_my_class_x { width: 100%; display: block; float: left; margin-top: 25px; }\r\n.tea_my_class:last-child { border: 0 }\r\n.tea_my_class_1 { width: 170px; display: block; float: left; padding-bottom: 10px; }\r\n.tea_my_class_1_1 img { width: 160px; }\r\n.tea_my_class_1_2 { width: 160px; display: block; float: left; line-height: 20px; margin-top: 5px; }\r\n.tea_my_class ul:last-child { border: none }\r\n.btn_delete{ color: #666}\r\n.btn_delete .fa{ color: #f90}\r\n.alert-white{ background: #fff;border-color: #eeeeee;color: #333333;}\r\n.alert-white .glyphicon-volume-down{ color: #999}\r\n\r\n\r\n/*返回顶部*/\r\n#back-to-top,#back-to-top2{ z-index: 1}\r\n#back-to-top{position:fixed;bottom:155px;right:0px;display:none;}\r\n#back-to-top a{text-align:center;text-decoration:none;color:#d1d1d1;display:block;width:33px;\r\n-moz-transition:color 1s;\r\n-webkit-transition:color 1s;\r\n-o-transition:color 1s;}\r\n#back-to-top a:hover{color:#00cdcb;}\r\n#back-to-top a .top_1{background:#00b2b0 url(../images/backtotop_1.png)  no-repeat center center;border-radius:4px 0 0 0;display:block;height:33px;width:33px;margin-bottom:1px;cursor:pointer;\r\n/*使用CSS3中的transition属性给<span>标签背景颜色添加渐变效果*/\r\n-moz-transition:background 300ms;\r\n -webkit-transition:background 300ms;\r\n-o-transition:background 300ms;}\r\n#back-to-top2{position:fixed;bottom:49px;right:0px;display:none;}\r\n#back-to-top2 a{text-align:center;text-decoration:none;color:#d1d1d1;display:block;width:33px;\r\n-moz-transition:color 1s;\r\n-webkit-transition:color 1s;\r\n-o-transition:color 1s;}\r\n#back-to-top2 a:hover{color:#00cdcb;}\r\n#back-to-top2 a .top_2{background:#00b2b0 url(../images/backtotop_3.png) no-repeat center center;border-radius: 0 0 0 4px;display:block;height:33px;width:33px;margin-bottom:5px; cursor:pointer;\r\n/*使用CSS3中的transition属性给<span>标签背景颜色添加渐变效果*/\r\n-moz-transition:background 300ms;\r\n -webkit-transition:background 300ms;\r\n-o-transition:background 300ms;}\r\n#back-to-top2 a:hover .top_2{background:#17D8D6 url(../images/backtotop_3.png) no-repeat center center;}\r\n#back-to-top2 a .top_3{background:#00b2b0 url(../images/backtotop_4.png) no-repeat center center; font-size: 23px; color: #fff; border-radius: 0px;height:33px;width:33px;margin-bottom:1px; cursor:pointer; \r\n/*使用CSS3中的transition属性给<span>标签背景颜色添加渐变效果*/\r\n-moz-transition:background 300ms;\r\n -webkit-transition:background 300ms;\r\n-o-transition:background 300ms;position:relative;  }\r\n#back-to-top2 a .top_3 .top_3_1{opacity: 0; height:0; width:0; display:block; color:#fff; position:absolute; left:100px; top:-231px; }\r\n#back-to-top2 a:hover .top_3_1{opacity: 1;  position:absolute; left:-258px; top:-246px; }\r\n#back-to-top2 a .top_4{background:#00b2b0 url(../images/backtotop_5.png) no-repeat center center;font-size: 18px; padding-top: 4px; color: #fff;border-radius: 0px;display:block; height:33px;width:33px;margin-bottom:1px; cursor:pointer;\r\n-moz-transition:background 300ms;\r\n -webkit-transition:background 300ms;\r\n-o-transition:background 300ms;}\r\n#back-to-top2 a:hover .top_3,#back-to-top2 a:hover .top_4{background-color:#17D8D6}\r\n/*返回顶部-end*/\r\n\r\n.no_class_11 { width: auto; line-height: 55px; margin: 20px 0 10px 0; font-size: 29px; color: #ccc; display: block; background: no-repeat url(../images/notice_1.png) 200px 7px; background-color: #eee; text-indent: 100px; }\r\n.no_class_1 { font-size: 29px;color: #ccc; margin-top: 30px }\r\n.no_class_1 .glyphicon{ margin-right: 10px; font-size: 25px;}\r\n.no_class_2_1 { width: auto; display: block; float: left; padding: 6px 10px; background: #ccc; color: #fff; font-size: 20px; margin-right: 20px; }\r\n.no_class_2_2 { font-size: 22px; display: block; float: left; width: 580px; margin-top: -6px }\r\n.no_class_2 li { margin-bottom: 30px; color: #999; font-size: 16px; width: 100%; display: block; float: left }\r\n.no_class_2_3 { line-height: 25px; width: 580px; display: block; float: left; margin-top: 5px; color: #ccc }\r\n.no_class_btn { color: #ccc; line-height: 45px;}\r\n/*tiny-box*/\r\n.tbox {position:absolute; display:none; padding:14px 17px; z-index:900}\r\n.tinner {padding:0; -moz-border-radius:3px; border-radius:3px; background:#fff url(../images/preload.gif) no-repeat 50% 50%; border-right:1px solid #333; border-bottom:1px solid #333}\r\n.tmask {position:absolute; display:none; top:0px; left:0px; height:100%; width:100%; background:#000; z-index:800}\r\n.tclose {position:absolute; top:5px; right:5px; width:30px; height:30px; cursor:pointer; background:url(../images/close.png) no-repeat}\r\n.tclose:hover {background-position:0 -30px}\r\n\r\n#error {background:#ff6969; color:#fff; text-shadow:1px 1px #cf5454; border-right:1px solid #000; border-bottom:1px solid #000; padding:0}\r\n#error .tcontent {padding:10px 14px 11px; border:1px solid #ffb8b8; -moz-border-radius:5px; border-radius:5px}\r\n#success {background:#2ea125; color:#fff; text-shadow:1px 1px #1b6116; border-right:1px solid #000; border-bottom:1px solid #000; padding:10; -moz-border-radius:0; border-radius:0}\r\n#bluemask {background:#000}\r\n#frameless {padding:0}\r\n#frameless .tclose {left:6px}\r\n/*tiny-box-end*/\r\n\r\n.pop_up_title{ margin-bottom: 20px; margin-top: 10px; border-bottom: 2px solid #bbb; padding-bottom: 8px;}\r\n.pop_up .control-label{  margin-top: 10px; padding: 0; text-align: right}\r\n.pop_up .form-control{  float: right}\r\n.modal-footer .blue,.modal-footer .default{ background: #00b2b0; color: #fff; padding: 6px 20px;}\r\n.modal-footer .default{ background: #ccc; color: #333;}\r\n.main_1_column{ background: #fff; padding-bottom: 30px;}\r\n.col_title{ margin-bottom: 30px;  border-bottom: 1px solid #ddd; padding-bottom: 10px;}\r\n.col_title span{ width: auto; border-bottom: 2px solid #00b2b0; padding-bottom: 10px; font-size: 17px;}\r\n.content_btn{text-align: center; margin-top: 30px;}\r\n.content_btn .btn{margin-left: 10px;}\r\n.content_btn .btn:first-child{ margin-left: 0}\r\n.btn-primary_1{ padding: 10px 16px; color: #fff; background-color: #00b2b0;-moz-transition-property: box-shadow, color; -webkit-transition: color .2s linear, background-color .3s linear, border-color .3s linear; -moz-transition: color .2s linear, background-color .3s linear, border-color .3s linear; -o-transition: color .2s linear, background-color .3s linear, border-color .3s linear; -ms-transition: color .2s linear, background-color .3s linear, border-color .3s linear; transition: color .2s linear, background-color .3s linear, border-color .3s linear; margin-right: 10px;}\r\n.btn-primary_1:hover,.btn-primary_1:focus{background-color: #00cec8;color: #fff; }\r\n.btn-primary_1:checked{color: #fff; }\r\n.btn-primary-gray_1{ background: #E1E1E1; color: #666}\r\n.btn-primary-gray_1:hover{ background: #ccc; color: #333}\r\n.list_announce span{ color: #999}\r\n.list_announce span:first-child{ max-height:42px;  overflow: hidden; color: #333; display: block}\r\n.list_announce { margin-bottom: 10px;}\r\n.list_announce h4{ margin-bottom: 0}\r\n.list_announce a .text-left:hover{ color: #f90}\r\n\r\n.loading {border: 0}\r\n.loading dd{ margin-bottom: 10px;}\r\n.panel_custom {border-radius: 0; border: none; margin-top: 0; margin-bottom: 10px; box-shadow: none}\r\n\r\n.myclass > div{ padding-left: 0; margin-bottom: 10px;}\r\n.myclass > div:hover h5 a{ color: #f90}\r\n.myclass > div h5 { height: 30px;}\r\n.myclass { padding-left: 15px;}\r\n.myclass .thumbnail{ border: none; padding: 0;position: relative; margin-bottom: 0; }\r\n.myclass .col-xs-3 .thumbnail {overflow: hidden; max-height: 137px;}\r\n.myclass .col-xs-4 .thumbnail {overflow: hidden; max-height: 139px;}\r\n.myclass .thumbnail h5{ margin: 0; line-height: 20px;}\r\n.myclass .progress{border-radius: 10px; height: 8px; box-shadow: none; margin-top: 5px; margin-bottom: 6px;}\r\n/*.myclass .col-xs-3:nth-child(5) { display: none;}*/\r\n.search_result_1 .col-xs-3:last-child { display: inherit!important;}\r\n\r\n.myclass_xueqing .col-xs-3:last-child { display: inherit;}\r\n.myclass h4 a{ height: 40px; overflow: hidden; display: block; line-height: 20px;}\r\n.myclass h4{ margin-bottom: 5px}\r\n.myclass{ margin-bottom: 20px;}\r\n.myclass .thumbnail img{ border-radius:5px}\r\n.my_course_2 span,.my_course_2s span { position: relative; top: 46%;  background: #00b2b0; padding: 11px 17px; color: #fff; font-size: 14px; border-radius: 2px;}\r\n.my_course_2s span { left: 30px; top: 40px;}\r\n.thumbnail:hover .my_course_2,.thumbnail:hover .my_course_2s{ opacity: 1; height: 100%; cursor: pointer;border-radius:5px}\r\n.thumbnail:hover .my_course_2s{ heig1ht: 100%;}\r\n.thumbnail:hover h5{ color: #00b2b0}\r\n.my_course_2 { position: absolute; left: 0px; top: 0px; width:100%; background-color: #000; background: rgba(0,0,0,0.7)!important; filter: alpha(opacity=90); opacity: 0; height: 0; overflow: hidden; -webkit-transition: opacity .25s ease .01s; -moz-transition: opacity .25s ease .01s; -o-transition: opacity .25s ease .01s; -ms-transition: opacity .25s ease .01s; transition: opacity .25s ease .01s; }\r\n.thumbnail .my_course_done{ position: absolute; left: 0px; top: 0px; width:100%; height: 100%; cursor: pointer;background-color: #000; border-radius: 5px; background: rgba(0,0,0,0.1)!important; filter: alpha(opacity=10); opacity: 1; }\r\n.thumbnail .my_course_done span{position: relative; margin: 0 auto;  top: 45%; background: #00b2b0; padding: 11px 17px; color: #fff; font-size: 14px; border-radius: 2px;}\r\n\r\n.c_11 a,.c_11x{ position: absolute; top: 5px; right: 20px; background: #F60; padding: 3px 10px; color: #fff; font-size: 12px; border-radius: 15px;}\r\n.c_11 span { font-weight: bold; font-size: 12px }\r\n.c_11 a:hover{background: #F90;}\r\n.c_11x{position: absolute; top: 0; right: 0px; background: #F60; padding: 3px 10px; color: #fff; font-size: 12px ;opacity: 0}\r\n.thumbnail:hover .c_11x{opacity: 1}\r\n\r\n\r\n/*timeline*/\r\n.page-body .main-content .cbp_tmtimeline:before { background: #eee; width: 5px; margin-left: -21px; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmtime > span { color: #575858; font-size: 15px; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmtime > span:first-child { font-weight: bold; margin-bottom: 2px; width: 100%;  white-space: nowrap; overflow: hidden; display: block; float: right; text-overflow: ellipsis}\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmtime > span:last-child { color: #979898; zoom: 1; -webkit-opacity: 0.8; -moz-opacity: 0.8; opacity: 0.8;  -ms-filter: progid:DXImageTransform.Microsoft.Alpha(Opacity=80);\r\nfilter: alpha(opacity=80); font-size: 12px; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmtime > span.large { font-size: 17px; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmtime > span.hidden + span { margin-top: 8px; }\r\n/*.page-body .main-content .cbp_tmtimeline > li .cbp_tmicon { background: #eee; color: #979898; -webkit-box-shadow: 0px 0px 0px 3px #eee; -moz-box-shadow: 0px 0px 0px 3px #eee; box-shadow: 0px 0px 0px 3px #eee; }*/\r\n.cbp_tmtimeline > li .cbp_tmicon { width: 31px; height: 31px; speak: none; font-style: normal; font-weight: normal; font-variant: normal; text-transform: none; font-size: 1.1em; line-height: 31px; -webkit-font-smoothing: antialiased; position: absolute; color: #fff; background: #46a4da; border-radius: 50%;  text-align: center; left: 19%; top: 0; margin: 0 0 0 -25px; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmicon.timeline-bg-primary { background-color: #2c2e2f; color: #fff; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmicon.timeline-bg-success { background-color: #8dc63f; color: #fff; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmicon.timeline-bg-info { background-color: #40bbea; color: #fff; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmicon.timeline-bg-danger { background-color: #f60; color: #fff; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmicon.timeline-bg-warning { background-color: #ffba00; color: #fff; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmicon.timeline-bg-red { background-color: #FC7676; color: #fff; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmicon.timeline-bg-purple { background-color: #4394E9; color: #fff; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmicon.timeline-bg-gray { background-color: #ddd; color: #777; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmicon.timeline-bg-orange { background-color: #E8B902; color: #fff; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmicon.timeline-bg-cy { background-color: #26C9B9; color: #fff; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmicon.timeline-bg-cy2 { background-color: #6AB76A; color: #fff; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmicon.timeline-bg-cy3 { background-color: #D66CDB; color: #fff; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmicon.timeline-bg-cy4 { background-color: #A58958; color: #fff; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmicon.timeline-bg-cy5 { background-color: #8398E8; color: #fff; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmlabel { background: #F5F5F5; color: #737881; margin-bottom: 15px; padding: 10px; -webkit-border-radius: 0px; -webkit-background-clip: padding-box; -moz-border-radius: 0px; -moz-background-clip: padding; border-radius: 0px; background-clip: padding-box; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmlabel h2, .page-body .main-content .cbp_tmtimeline > li .cbp_tmlabel p { color: #737881; font-size: 13px; margin: 0; line-height: 1.42857143; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmlabel p + p { margin-top: 10px; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmlabel h2 { font-size: 15px; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmlabel h2 a { color: #303641; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmlabel h2 span { zoom: 1; -webkit-opacity: 0.6; -moz-opacity: 0.6; opacity: 0.6;  -ms-filter: progid:DXImageTransform.Microsoft.Alpha(Opacity=60);\r\nfilter: alpha(opacity=60); }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmlabel blockquote { font-size: 14px; padding-top: 4px; padding-bottom: 4px; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmlabel:after { border-right-color: #F5F5F5; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmlabel.empty { background: 0; padding: 9px 0; margin-bottom: 70px; }\r\n.page-body .main-content .cbp_tmtimeline > li .cbp_tmlabel.empty:after { visibility: hidden; }\r\n.cbp_tmtimeline { margin: 30px 0 0 0; padding: 0; list-style: none; position: relative; }\r\n\r\n.cbp_tmtimeline:before { content: ''; position: absolute; top: 0; bottom: 0; width: 10px; background: #afdcf8; left: 20%; margin-left: -10px; }\r\n.cbp_tmicon img{ width:31px; height: 31px; object-fit: cover; border-radius: 50% }\r\n.cbp_tmtimeline > li { position: relative; }\r\n.cbp_tmtimeline > li .cbp_tmtime { display: block; width: 25%; padding-right: 80px; position: absolute;}\r\n.cbp_tmtimeline > li .cbp_tmtime span { display: block; text-align: right; }\r\n.cbp_tmtimeline > li .cbp_tmtime span:first-child { font-size: 0.9em; color: #bdd0db; }\r\n.cbp_tmtimeline > li .cbp_tmtime span:last-child { font-size: 2.9em; color: #3594cb; }\r\n.cbp_tmtimeline > li:nth-child(odd) .cbp_tmtime span:last-child { color: #6cbfee; }\r\n.cbp_tmtimeline > li .cbp_tmlabel { margin: 0 0 15px 25%; background: #3594cb; color: #fff; padding: 2em;  line-height: 1.4; position: relative; border-radius: 5px; }\r\n.cbp_tmtimeline > li:nth-child(odd) .cbp_tmlabel { background: #6cbfee; }\r\n.cbp_tmtimeline > li .cbp_tmlabel h2 { margin-top: 0px; padding: 0 0 10px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.4); }\r\n\r\n.cbp_tmtimeline > li .cbp_tmlabel:after { right: 100%; border: solid transparent; content: \" \"; height: 0; width: 0; position: absolute; pointer-events: none; border-right-color: #3594cb; border-width: 10px; top: 10px; }\r\n.cbp_tmtimeline > li:nth-child(odd) .cbp_tmlabel:after { border-right-color: #6cbfee; }\r\n.timeline_class{ color: #00b2b0}\r\n.swjl .cbp_tmtimeline > li .cbp_tmtime {width: 22%;}\r\n\r\n/*timeline-end*/\r\n\r\n.breadcrumb {\r\n    padding: 8px 15px 8px 0;\r\n    margin-b1ottom: 10px;\r\n    list-style: none;\r\n    background-color: #f5f5f5;\r\n    border-radius: 4px;\r\n}\r\n.breadcrumb.auto-hidden:after {\r\n  clear: both;\r\n}\r\n.breadcrumb.auto-hidden li {\r\n  display: block;\r\n  float: left;\r\n}\r\n.breadcrumb.auto-hidden li:before {\r\n  display: inline-block;\r\n  float: left;\r\n}\r\n.breadcrumb.auto-hidden li a { color: #00b2b0;background-color: transparent;\r\n  display: inline-block;\r\n  float: left;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  -webkit-transition: all 220ms ease-in-out;\r\n  -moz-transition: all 220ms ease-in-out;\r\n  -o-transition: all 220ms ease-in-out;\r\n  transition: all 220ms ease-in-out;\r\n}\r\n\r\n.breadcrumb.auto-hidden li a.collapsed {  \r\n  width: 55px !important;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.breadcrumb > li + li:before { \r\n    padding: 0 5px;\r\n    color: #ccc;\r\n  content: \">\";}\r\n\r\n.btn-more{ background-color: #eee; color: #666}\r\n.btn-more_2{ background-color: #eee; color: #666; padding-top: 4px; padding-bottom: 4px; margin-bottom: 30px; margin-top: -15px;}\r\n.input-group-addon_1{ font-size: 12px!important; padding: 5px 15px!important; border-radius: 0!important}\r\n.recommand_book_list{  padding: 0;}\r\n.recommand_book_list .thumbnail{ border:1px solid #ddd; border-radius: 0; padding: 0; margin-bottom: 15px; }\r\n.recommand_book_list div{ padding:0; padding-left: 15px;}\r\n.recommand_book_list div:last-child{ margin-bottom: 10px; padding-right: 10px;}\r\n.recommand_book_list div:last-child a{ height: 40px; overflow: hidden}\r\n.icon_pad a { width: 30px;}\r\n.icon_pad a img{ width: 30px; border: 2px solid #ccc}\r\n.icon_pad span{ margin-left: 10px; width: auto; display: inline-block; padding-top: 5px;}\r\n.icon_pad_nav a { padding: 7px 13px; background: #efefef; margin-right: 10px;}\r\n.class_list { border-bottom: 1px solid #e9e9e9; padding-bottom: 15px;  margin-bottom: 5px;}\r\n.class_list_1{ width: 100%; display: block; float: left; margin-bottom: 10px;}\r\n.class_list_1 span{ margin-top: 23px; color: #999}\r\n.class_list_1 span .fa{ padding-right: 5px;}\r\n.class_list_2 .col-md-3{ padding-right: 0!important}\r\n.class_list_2 .col-md-6{ line-height: 2em; margin-top: -5px;height: 110px; display: block; overflow: hidden; color: #666}\r\n.btn-blist{  padding: 12px 30px;\r\n    background: #00c2c0;\r\n    color: #fff;\r\n    font-size: 19px;\r\n    -webkit-box-shadow: 0px 2px 0px #408080;\r\n    -moz-box-shadow: 0px 2px 0px #408080;\r\n    box-shadow: 0px 2px 0px #408080; margin-left: 10px; margin-top: 15px;}\r\n.btn-blist:hover{ background: #00d9d7;\r\n    color: #fff;}\r\n.sidebar2{padding-right: 0}\r\n.sidebar2 .list-group-item_tit {border-radius: 0; border: none;}\r\n.sidebar2 .list-group{ background: #fff; margin-bottom: 10px; padding-bottom: 10px;}\r\n.sidebar_course_1{ padding-right: 0;  top: -160px;}\r\n.sidebar_course_2{ padding: 15px; background: #fff; border-radius: 5px 5px 0 0; margin-bottom: 10px;}\r\n.sidebar_course_2_img{width: 100%; border-radius: 5px; margin-bottom: 10px }\r\n.sidebar_course_2 .progress{ height: 10px; margin-bottom: 15px;}\r\n.list-group-item_tit h4{ margin: 0}\r\n.list-group-item_tit{ margin-bottom: 10px; padding-top: 20px;}\r\n.tag_main{padding-left: 10px; padding-right: 10px;}\r\n.tag_main a { margin-right: 10px; line-height: 30px; white-space: nowrap }\r\n.tag_main a:hover { color: #f60 }\r\n.tah_1 { font-size: 14px; color: #999; }\r\n.tah_2 { font-size: 14px; color: #000; }\r\n.tah_3 { font-size: 17px; color: #38aaa9; }\r\n.tah_4 { font-size: 20px; color: #087675; }\r\n.chart_1{ padding-left: 15px; padding-right: 15px;}\r\n.chart_2_1{ font-size: 16px; font-weight: bold; float: left; width: 25px; display: block; }\r\n.chart{ border: none}\r\n.tea_class_list .tea_myclass_list_1 { border-bottom: 1px solid #ddd; padding-bottom: 20px; margin-bottom: 20px;}\r\n\r\n.tea_myclass_list_1{  position: relative;}\r\n.tea_myclass_list_1_1{ width: 80%; font-size: 18px; color: #444; line-height: 1.3em; font-weight: bold; display: block; text-overflow: ellipsis; white-space: nowrap;overflow: hidden}\r\n.tea_myclass_list_1_2{ width: 110px; text-align: right;color: #00A2A0}\r\n.tea_myclass_list_1_2 div:last-child{ display: inline-block; margin-top: 13px; font-size: 13px; }\r\n.tea_myclass_list_1_2 .btn{ font-size: 11px; padding: 3px 7px; margin-top: -5px; color: #666}\r\n.tea_my_class_2_2 { width: 570px; display: block; float: left; font-size: 14px; color: #999; margin-top: 10px; margin-left: 1px;  }\r\n.tea_my_class_2_2_1,.tea_my_class_2_2_3 { color: #00b2b0; margin-left: 15px; border: 1px solid #00b2b0; border-radius: 15px; padding-left: 3px; padding-right: 3px; width: auto!important;}\r\n.tea_my_class_2_2 span:first-child{  width: 360px; display: inline-block}\