            "size": 14427,
            "mimeType": "application/json",
            "text": "{\"status\":0,\"data\":{\"testId\":230550,\"isFinish\":false,\"answerSheet\":\"<!DOCTYPE html PUBLIC \\\"-//W3C//DTD HTML 4.01 Transitional//EN\\\" \\\"http://www.w3.org/TR/html4/loose.dtd\\\"><h4><strong>全新版高阶听说B2U1</strong></h4><h4>Listening Comprehension</h4><div class=\\\"answer_sheet_1\\\"><a id=\\\"aQuestion1\\\" href=\\\"javascript:SelQuestion(1,1);\\\"><span>1</span></a><a id=\\\"aQuestion2\\\" href=\\\"javascript:SelQuestion(1,2);\\\"><span>2</span></a><a id=\\\"aQuestion3\\\" href=\\\"javascript:SelQuestion(1,3);\\\"><span>3</span></a><a id=\\\"aQuestion4\\\" class=\\\"answer_sheet_2\\\" href=\\\"javascript:SelQuestion(1,4);\\\"><span>4</span></a><a id=\\\"aQuestion5\\\" class=\\\"answer_sheet_2\\\" href=\\\"javascript:SelQuestion(1,5);\\\"><span>5</span></a><a id=\\\"aQuestion6\\\" class=\\\"answer_sheet_2\\\" href=\\\"javascript:SelQuestion(1,6);\\\"><span>6</span></a><a id=\\\"aQuestion7\\\" class=\\\"answer_sheet_2\\\" href=\\\"javascript:SelQuestion(1,7);\\\"><span>7</span></a><a id=\\\"aQuestion8\\\" href=\\\"javascript:SelQuestion(1,8);\\\"><span>8</span></a><a id=\\\"aQuestion9\\\" href=\\\"javascript:SelQuestion(1,9);\\\"><span>9</span></a><a id=\\\"aQuestion10\\\" href=\\\"javascript:SelQuestion(1,10);\\\"><span>10</span></a></div>\",\"paperContent\":\"<!DOCTYPE html PUBLIC \\\"-//W3C//DTD HTML 4.01 Transitional//EN\\\" \\\"http://www.w3.org/TR/html4/loose.dtd\\\"><div id=\\\"part1\\\" class=\\\"tab-pane active partDiv\\\"><h4 class=\\\"test_sty_1\\\"><span>Listening Comprehension</span></h4><blockquote><div class=\\\"test_sty_2\\\"><p>Section A</p><strong>Directions: </strong>In this section, you will hear several news reports. At the end of each news report, you will hear two or three questions. Both the news report and the questions will be spoken only once. After you hear a question, you must choose the best answer from the four choices marked A), B), C) and D).</div></blockquote><div class=\\\"itemDiv\\\"><div style=\\\"font-weight:bold;\\\">Questions 1 to 3 will be based on the following news item.</div><div class=\\\"text-center\\\"><a id=\\\"btnPlay_5B575689F52F4365AAFC25B24A61BF08_prompt_2\\\" href=\\\"javascript:PlaySound(&quot;9c48d8d3e3024f349e002441dd718ebc.mp3&quot;,&quot;5B575689F52F4365AAFC25B24A61BF08_prompt_2&quot;);\\\"><span class=\\\" fa fa-play-circle play_symble\\\">0次播放机会</span></a></div><div class=\\\"test_hov\\\"><div><span class=\\\"test_number\\\">1.</span><a id=\\\"btnPlay_5B575689F52F4365AAFC25B24A61BF08_1\\\" href=\\\"javascript:PlaySound(&quot;44f12f39a7b44ff88e76ca262c0f5cd8.mp3&quot;,&quot;5B575689F52F4365AAFC25B24A61BF08_1&quot;);\\\"><span class=\\\" fa fa-play-circle play_symble\\\">2次播放机会</span></a></div><span id=\\\"question_1\\\"></span><div class=\\\"choiceList\\\"><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_1\\\" data-qNum=\\\"1\\\" data-id=\\\"1\\\">A) Lack of preparation time for the Olympic Games.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_1\\\" data-qNum=\\\"1\\\" data-id=\\\"2\\\">B) Failure to qualify for the Olympic Games.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_1\\\" data-qNum=\\\"1\\\" data-id=\\\"3\\\">C) No sponsorship.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_1\\\" data-qNum=\\\"1\\\" data-id=\\\"4\\\">D) Lack of international competition.</label></div></div></div><div class=\\\"test_hov\\\"><div><span class=\\\"test_number\\\">2.</span><a id=\\\"btnPlay_5B575689F52F4365AAFC25B24A61BF08_2\\\" href=\\\"javascript:PlaySound(&quot;5a446193fc9c4bdc85c06257d4b81512.mp3&quot;,&quot;5B575689F52F4365AAFC25B24A61BF08_2&quot;);\\\"><span class=\\\" fa fa-play-circle play_symble\\\">3次播放机会</span></a></div><span id=\\\"question_2\\\"></span><div class=\\\"choiceList\\\"><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_2\\\" data-qNum=\\\"2\\\" data-id=\\\"1\\\">A) To participate in intra-team competition.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_2\\\" data-qNum=\\\"2\\\" data-id=\\\"2\\\">B) To witness the signing of a contract.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_2\\\" data-qNum=\\\"2\\\" data-id=\\\"3\\\">C) To try the new outfit.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_2\\\" data-qNum=\\\"2\\\" data-id=\\\"4\\\">D) To fly to Switzerland for a competition.</label></div></div></div><div class=\\\"test_hov\\\"><div><span class=\\\"test_number\\\">3.</span><a id=\\\"btnPlay_5B575689F52F4365AAFC25B24A61BF08_3\\\" href=\\\"javascript:PlaySound(&quot;380e1ff54b03446d9c14ec0a0aa185ef.mp3&quot;,&quot;5B575689F52F4365AAFC25B24A61BF08_3&quot;);\\\"><span class=\\\" fa fa-play-circle play_symble\\\">3次播放机会</span></a></div><span id=\\\"question_3\\\"></span><div class=\\\"choiceList\\\"><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_3\\\" data-qNum=\\\"3\\\" data-id=\\\"1\\\">A) It affected the team’s Olympic entry qualification.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_3\\\" data-qNum=\\\"3\\\" data-id=\\\"2\\\">B) The team couldn’t observe foreign opponents on the spot.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_3\\\" data-qNum=\\\"3\\\" data-id=\\\"3\\\">C) The team can’t set a definite goal.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_3\\\" data-qNum=\\\"3\\\" data-id=\\\"4\\\">D) The players’ world ranking fell sharply.</label></div></div></div></div><blockquote><div class=\\\"test_sty_2\\\"><p>Section B</p><strong>Directions: </strong>In this section, you will hear several conversations. At the end of each conversation, one or more questions will be asked about what was said. Both the conversations and the questions will be spoken only once. After each question there will be a pause. During the pause, you must read the four choices marked A), B), C) and D), and decide which is the best answer.</div></blockquote><div class=\\\"itemDiv\\\"><div class=\\\"text-center\\\"><a id=\\\"btnPlay_B05066742F2945ABAE366A334D064528_prompt_2\\\" href=\\\"javascript:PlaySound(&quot;646e30b4477f4c11a031321db3d1df64.mp3&quot;,&quot;B05066742F2945ABAE366A334D064528_prompt_2&quot;);\\\"><span class=\\\" fa fa-play-circle play_symble\\\">1次播放机会</span></a></div><div style=\\\"font-weight:bold;\\\">Questions 4 to 7 are based on the conversation you have just heard.</div><div class=\\\"test_hov\\\"><div><span class=\\\"test_number\\\">4.</span><a id=\\\"btnPlay_B05066742F2945ABAE366A334D064528_1\\\" href=\\\"javascript:PlaySound(&quot;dff52475d16e4ab6ab495d1942199020.mp3&quot;,&quot;B05066742F2945ABAE366A334D064528_1&quot;);\\\"><span class=\\\" fa fa-play-circle play_symble\\\">3次播放机会</span></a></div><span id=\\\"question_4\\\"></span><div class=\\\"choiceList\\\"><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_4\\\" data-qNum=\\\"4\\\" data-id=\\\"1\\\">A) He isn’t interested in soccer.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_4\\\" data-qNum=\\\"4\\\" data-id=\\\"2\\\" checked>B) His favorite team was eliminated in the first round.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_4\\\" data-qNum=\\\"4\\\" data-id=\\\"3\\\">C) His favorite team was defeated in the second round.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_4\\\" data-qNum=\\\"4\\\" data-id=\\\"4\\\">D) His favorite team won the first round, but didn’t make it in the second round.</label></div></div></div><div class=\\\"test_hov\\\"><div><span class=\\\"test_number\\\">5.</span><a id=\\\"btnPlay_B05066742F2945ABAE366A334D064528_2\\\" href=\\\"javascript:PlaySound(&quot;05e8942bc20e470dbcb2cadc12496b45.mp3&quot;,&quot;B05066742F2945ABAE366A334D064528_2&quot;);\\\"><span class=\\\" fa fa-play-circle play_symble\\\">3次播放机会</span></a></div><span id=\\\"question_5\\\"></span><div class=\\\"choiceList\\\"><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_5\\\" data-qNum=\\\"5\\\" data-id=\\\"1\\\" checked>A) Players’ injuries.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_5\\\" data-qNum=\\\"5\\\" data-id=\\\"2\\\">B) Players’ mistakes.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_5\\\" data-qNum=\\\"5\\\" data-id=\\\"3\\\">C) Referee’s mistakes.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_5\\\" data-qNum=\\\"5\\\" data-id=\\\"4\\\">D) Strong opposing team.</label></div></div></div><div class=\\\"test_hov\\\"><div><span class=\\\"test_number\\\">6.</span><a id=\\\"btnPlay_B05066742F2945ABAE366A334D064528_3\\\" href=\\\"javascript:PlaySound(&quot;856217b4594a4c84a33bbb86fe4623d3.mp3&quot;,&quot;B05066742F2945ABAE366A334D064528_3&quot;);\\\"><span class=\\\" fa fa-play-circle play_symble\\\">3次播放机会</span></a></div><span id=\\\"question_6\\\"></span><div class=\\\"choiceList\\\"><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_6\\\" data-qNum=\\\"6\\\" data-id=\\\"1\\\">A) Two star players were absent.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_6\\\" data-qNum=\\\"6\\\" data-id=\\\"2\\\">B) The opposing team robbed the man’s favorite team.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_6\\\" data-qNum=\\\"6\\\" data-id=\\\"3\\\" checked>C) One player kicked the ball into his own goal.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_6\\\" data-qNum=\\\"6\\\" data-id=\\\"4\\\">D) The opposing team won the match unexpectedly.</label></div></div></div><div class=\\\"test_hov\\\"><div><span class=\\\"test_number\\\">7.</span><a id=\\\"btnPlay_B05066742F2945ABAE366A334D064528_4\\\" href=\\\"javascript:PlaySound(&quot;d87987bb60cd4851986f6b31a1aea72b.mp3&quot;,&quot;B05066742F2945ABAE366A334D064528_4&quot;);\\\"><span class=\\\" fa fa-play-circle play_symble\\\">3次播放机会</span></a></div><span id=\\\"question_7\\\"></span><div class=\\\"choiceList\\\"><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_7\\\" data-qNum=\\\"7\\\" data-id=\\\"1\\\">A) She’s ignorant of soccer.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_7\\\" data-qNum=\\\"7\\\" data-id=\\\"2\\\">B) She shows sympathy towards the man.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_7\\\" data-qNum=\\\"7\\\" data-id=\\\"3\\\" checked>C) She has been following the games.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_7\\\" data-qNum=\\\"7\\\" data-id=\\\"4\\\">D) She thought the referee was to blame.</label></div></div></div></div><blockquote><div class=\\\"test_sty_2\\\"><p>Section C</p><strong>Directions: </strong>In this section, you will hear several short passages. At the end of each passage, you will hear some questions. Both the passage and the questions will be spoken only once. After you hear a question, you must choose the best answer from the four choices marked A), B), C) and D).</div></blockquote><div class=\\\"itemDiv\\\"><div style=\\\"font-weight:bold;\\\">Passage One</div><div class=\\\"text-center\\\"><a id=\\\"btnPlay_8FAAC41C7ACF40738C4A32F324BA5398_prompt_3\\\" href=\\\"javascript:PlaySound(&quot;1f8fd5d07b35454d997cb0eafd07c9c1.mp3&quot;,&quot;8FAAC41C7ACF40738C4A32F324BA5398_prompt_3&quot;);\\\"><span class=\\\" fa fa-play-circle play_symble\\\">3次播放机会</span></a></div><div style=\\\"font-weight:bold;\\\">Questions 8 to 10 are based on the passage you have just heard.</div><div class=\\\"test_hov\\\"><div><span class=\\\"test_number\\\">8.</span><a id=\\\"btnPlay_8FAAC41C7ACF40738C4A32F324BA5398_1\\\" href=\\\"javascript:PlaySound(&quot;2f67a7162d5f4f5e90244fa87707f102.mp3&quot;,&quot;8FAAC41C7ACF40738C4A32F324BA5398_1&quot;);\\\"><span class=\\\" fa fa-play-circle play_symble\\\">3次播放机会</span></a></div><span id=\\\"question_8\\\"></span><div class=\\\"choiceList\\\"><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_8\\\" data-qNum=\\\"8\\\" data-id=\\\"1\\\">A) The runners arrive at 9 am.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_8\\\" data-qNum=\\\"8\\\" data-id=\\\"2\\\">B) It starts at the park.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_8\\\" data-qNum=\\\"8\\\" data-id=\\\"3\\\">C) It starts at the front of the castle.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_8\\\" data-qNum=\\\"8\\\" data-id=\\\"4\\\">D) They will run 5 miles.</label></div></div></div><div class=\\\"test_hov\\\"><div><span class=\\\"test_number\\\">9.</span><a id=\\\"btnPlay_8FAAC41C7ACF40738C4A32F324BA5398_2\\\" href=\\\"javascript:PlaySound(&quot;e4d037ad3c1e4adaa5ab90b5fb864d84.mp3&quot;,&quot;8FAAC41C7ACF40738C4A32F324BA5398_2&quot;);\\\"><span class=\\\" fa fa-play-circle play_symble\\\">3次播放机会</span></a></div><span id=\\\"question_9\\\"></span><div class=\\\"choiceList\\\"><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_9\\\" data-qNum=\\\"9\\\" data-id=\\\"1\\\">A) One thousand pounds.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_9\\\" data-qNum=\\\"9\\\" data-id=\\\"2\\\">B) A certificate.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_9\\\" data-qNum=\\\"9\\\" data-id=\\\"3\\\">C) A computer.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_9\\\" data-qNum=\\\"9\\\" data-id=\\\"4\\\">D) Sports equipment.</label></div></div></div><div class=\\\"test_hov\\\"><div><span class=\\\"test_number\\\">10.</span><a id=\\\"btnPlay_8FAAC41C7ACF40738C4A32F324BA5398_3\\\" href=\\\"javascript:PlaySound(&quot;db8ee6b6e37440b89bd9efefec1f69a9.mp3&quot;,&quot;8FAAC41C7ACF40738C4A32F324BA5398_3&quot;);\\\"><span class=\\\" fa fa-play-circle play_symble\\\">3次播放机会</span></a></div><span id=\\\"question_10\\\"></span><div class=\\\"choiceList\\\"><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_10\\\" data-qNum=\\\"10\\\" data-id=\\\"1\\\">A) The referee will tell the results to the runners.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_10\\\" data-qNum=\\\"10\\\" data-id=\\\"2\\\">B) By scanning a bar code.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_10\\\" data-qNum=\\\"10\\\" data-id=\\\"3\\\">C) By volunteering in the run.</label></div><div class=\\\"radio\\\"><label><input type=\\\"radio\\\" name=\\\"rd_10\\\" data-qNum=\\\"10\\\" data-id=\\\"4\\\">D) The manager will collect the results for the runners.</label></div></div></div></div></div>\",\"partNum\":1,\"paperAnswer\":{\"5B575689F52F4365AAFC25B24A61BF08_prompt_2\":{\"key\":\"5B575689F52F4365AAFC25B24A61BF08_prompt_2\",\"value\":\"0\",\"type\":\"sound\"},\"6\":{\"key\":\"6\",\"value\":\"3\",\"type\":\"question\"},\"B05066742F2945ABAE366A334D064528_prompt_2\":{\"key\":\"B05066742F2945ABAE366A334D064528_prompt_2\",\"value\":\"1\",\"type\":\"sound\"},\"4\":{\"key\":\"4\",\"value\":\"2\",\"type\":\"question\"},\"7\":{\"key\":\"7\",\"value\":\"3\",\"type\":\"question\"},\"5B575689F52F4365AAFC25B24A61BF08_1\":{\"key\":\"5B575689F52F4365AAFC25B24A61BF08_1\",\"value\":\"2\",\"type\":\"sound\"},\"5\":{\"key\":\"5\",\"value\":\"1\",\"type\":\"question\"}},\"remainSeconds\":275}}"
